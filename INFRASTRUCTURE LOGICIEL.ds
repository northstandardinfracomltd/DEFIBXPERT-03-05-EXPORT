							reply to : "defibxpert@cardiacsafe.fr"
							subject : "Alerte SP Enseignement : Une nouvelle visite sur un appareil vous est attribuée"
							message : "<div>Bonjour&nbsp;${Quel_op_rateur_doit_faire_la_visite} !<br></div><div><br></div><div>Une nouvelle visite sur un appareil vous est attribuée :<br></div><div><br></div><div>Lieu de l'intervention :&nbsp;<br></div><div>${Localisation_de_la_visite.address_line_1} ${Localisation_de_la_visite.address_line_2}<br></div><div>${Localisation_de_la_visite.district_city}<br></div><div>${Localisation_de_la_visite.state_province}<br></div><div>${Localisation_de_la_visite.postal_Code}<br></div><div>${Localisation_de_la_visite.country}<br></div><div><br></div><div>Date de visite : <br></div><div>${Quand_l_op_rateur_doit_passer}<br></div><div><br></div><div>Numéro de série de l'appareil :&nbsp;<br></div><div>${DAE_Num_ro_de_s_rie}<br></div><div><br></div><div>Autres notes :<br></div><div>${Pr_cisions_l_op_rateur_territorial}<br></div><div><br></div><div><br></div><div>Vous êtes sur place ? Utilisez le rapport numérique impérativement en <a style=\"color: rgb(0, 0, 238);\" target=\"_blank\" href=\"http://visite-defibrillateur.spenseignement.eu/\" rel=\"noopener noreferrer\">cliquant ici</a> ou scannez le QR Code sur la fiche pratique.<br></div><div><br></div><div><br></div><div>https://creatorapp.zohopublic.eu/spenseignement/spilot/form-perma/Interventions/ZWDMjKPnGpJEXApCCk6RvTVFd4qRuBOsC7WYWwKKh6wR66CBvugm7AdwXaZBWOdCt7pyHt87tsnU7NV5RNaDEd1AO4vyERzRZnnV<span style=\"orphans: 2; text-align: start; text-indent: 0px; widows: 2; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;\">DAE_Num_ro_de_s_rie=151691000000388038 </span><br></div><div><br></div><div><br></div><div><br></div><div><br></div><div><br></div><div>Besoin d'aide ? Voici la fiche pratique avec les instructions : <a style=\"color: rgb(0, 0, 238);\" target=\"_blank\" href=\"http://visite-aide.spenseignement.eu\" rel=\"noopener noreferrer\">visite-aide.spenseignement.eu&nbsp;</a><br></div><div><br></div><div>Vous n'êtes pas disponible pour cette visite ? Une erreur ? Veuillez nous partager votre refus dès que possible en suivant ce lien :&nbsp;<a href=\"https://visite-refus.spenseignement.eu/\" target=\"_blank\" rel=\"noopener noreferrer\">visite-refus.spenseignement.eu</a><br></div><div><br></div><div><br></div><div>Référence de la visite :&nbsp;${Auto_Number}<br></div><div><br></div><div>(Création le :&nbsp;${Added_Time})<br></div><div><br></div><div><br></div><div>L'équipe SP Enseignement,<br><br></div><div><br></div><div><br></div><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br>"
						)
					}
				}
			}
			auto_populate_planing_lie as "auto populate planing lieu"
			{
				type =  form
				form = Planificateur
				record event = on add or edit

				on user input of DAE_Num_ro_de_s_rie
				{
					actions 
					{
						custom deluge script
						(
											DAERec = DAE[ID == input.DAE_Num_ro_de_s_rie];
										input.Emailrs = DAERec.Email_client_notifications;
										input.Localisation_de_la_visite = DAERec.Localisation_de_l_appareilDAE;
										input.Email_du_site = DAERec.Email_du_site;
										input.authtoken = DAERec.ID;
										input.doublecheckauth = DAERec.MiniCode1;
										input.Situation_contractuelle_avec_le_client = DAERec.TypeReport;
										input.Client_to_hide = DAERec.Client;
										input.reportcontrat_cacher = DAERec.TypeReport;
										input.Autre_Email_de_contact = DAERec.Autre_Email_de_contact;
										input.Information_Adresse = DAERec.Information_Adresse;
						)
					}
				}

			}
