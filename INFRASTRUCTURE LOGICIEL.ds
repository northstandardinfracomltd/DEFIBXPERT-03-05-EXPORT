		form Feedbackrdvdae
		{
			displayname = "Demande de changement sur la visite"
			captcha = true
			success message = "Votre demande nous est bien parvenue, vous pouvez fermer cet onglet"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			plain
			(
    			type = plaintext
				value = "<div style=\"text-align: center\" class=\"align-center\"><img src=\"https://cdn.glitch.global/b99994f5-4c44-4691-9f5c-108578f7e2e0/SP.png?v=1678964682686\" width=\"300px\"> &nbsp; <br /></div>"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Statut_de_la_demande
			(
				type = picklist
				displayname = "Statut de la demande"
				maxchar = 100
				values = {"À traiter","Demande annulée","Visite planifiée à nouveau"}
				initial value = "À traiter"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Je_proc_de
			(
				type = radiobuttons
				displayname = "Je procède en tant que"
				maxchar = 100
				values = {"Intervenant","Client"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have R_f_rence_de_la_visite
			(
				type = number
				displayname = "Référence de la visite"
	 			row = 1
	 			column = 1   
