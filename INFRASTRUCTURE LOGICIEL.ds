				 void updatesalltypes()
                 {
                 	for each  rec in DAE[ID != 0]
                 	{
                 		rec.TypeReport=ifnull(rec.SN1type.contract_choice,"") + " " + ifnull(rec.SN2type.contract_choice,"") + " " + ifnull(rec.SN3type.contract_choice,"") + " " + ifnull(rec.SN4type.contract_choice,"") + " " + ifnull(rec.SN5type.contract_choice,"") + " " + ifnull(rec.SN6type.contract_choice,"") + " " + ifnull(rec.SN7type.contract_choice,"") + " " + ifnull(rec.SN8type.contract_choice,"") + " " + ifnull(rec.SN9type.contract_choice,"") + " " + ifnull(rec.SN10type.contract_choice,"") + " " + ifnull(rec.SN11type.contract_choice,"") + " " + ifnull(rec.SN12type.contract_choice,"") + " " + ifnull(rec.SN13type.contract_choice,"") + " " + ifnull(rec.SN14type.contract_choice,"") + " " + ifnull(rec.SN16type.contract_choice,"") + " " + ifnull(rec.SN17type.contract_choice,"") + " " + ifnull(rec.SN18type.contract_choice,"") + " " + ifnull(rec.SN19type.contract_choice,"");
