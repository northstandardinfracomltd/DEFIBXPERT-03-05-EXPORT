		default list Tous_les_Stagiaires_Report
		{
			displayName = "Stagiaires / Certificats"
			print template = Certificat_Participation_Cardiac_Safe
			show all rows from Tous_les_Stagiaires    
			(
				Nom_Pr_nom as "Nom & Prénom"
				(
					width = 195px
				)
				Email
				(
					width = 214px
				)
				Participation as "Participation Formation"
				(
					width = 252px
				)
				Formationsss as "Statut"
				Date_Naissance as "Date Naissance"
				(
					width = 129px
				)
				Adresse_Postale  as "Adresse Postale Stagiaire"
	 			(
	      			displayformat = [address_line_1+""+address_line_2+""+district_city+""+state_province+""+postal_Code+""+country]
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Date_field1 as "Date Validation Formation"
				(
					width = 213px
				)
				custom action "Valider"
				(
	  			workflow = changestatut
				show action in edit record menu = true
				column header = "Valider"
				condition = (Formationsss == "En cours")
				confirmation before execution
				(
					message for individual record = "De quoi s'agit-il ? DéfibXpert va valider la formation pour ${Nom_Pr_nom} et permettre ainsi la génération du certificat/attestation."
					confirm button text = "Valider"		
					cancel button text = "Retour"
				)
				)
				custom action "Refuser"
				(
	  			workflow = aufrnunrfdddd
				show action in edit record menu = true
				column header = "Refuser"
				condition = (Formationsss == "En cours")
				confirmation before execution
				(
					message for individual record = "De quoi s'agit-il ? DéfibXpert va refuser la validation de la formation pour ${Nom_Pr_nom} et donc ne pas permettre ainsi la génération du certificat/attestation."
					confirm button text = "Refuser"		
					cancel button text = "Retour"
				)
				)
				custom action "Partager Attestation (PDF)"
				(
	  			workflow = ooooo
				show action in edit record menu = true
				column header = "Partager Attestation (PDF)"
				condition = (Formationsss == "Accordé" && Date_field1 is not null)
				confirmation before execution
				(
					message for individual record = "De quoi s'agit-il ? DéfibXpert va envoyer un email au stagiaire  ${Nom_Pr_nom} incluant le certificat/attestation de participation à la formation (PDF)."
					confirm button text = "Envoyer"		
					cancel button text = "Retour"
				)
				)
				custom action "Télécharger Attestation (PDF)"
				(
	  			workflow = telechargerpdf
				show action in edit record menu = true
				column header = "Télécharger Attestation (PDF)"
				condition = (Formationsss == "Accordé")
				confirmation before execution
				(
					message for individual record = "De quoi s'agit-il ? DéfibXpert va télécharger (1 page Paysage) le certification/attestation au format PDF pour  ${Nom_Pr_nom}"
					confirm button text = "Télécharger"		
					cancel button text = "Retour"
				)
				)
				T_l_phone as "Téléphone"
				(
					width = 167px
					displayformat = plainnumber 
					linktodial = enable
				)
				Adresse_Employeur  as "Adresse Employeur"
	 			(
	      			displayformat = [address_line_1+""+address_line_2+""+district_city+""+state_province+""+postal_Code+""+country]
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Employeurx as "Employeur"
			)
			conditional formatting
			(
				"ttttt"
				{
				fields = [Date_Naissance, Adresse_Postale, Date_field1, Nom_Pr_nom, Email, Participation, T_l_phone]
				format = "color:#2d3b90;background-color:#f7f8ff;"
				}
			)
		}
		list Registre_des_Clients
		{
			displayName = "Registre des Clients"
			show all rows from Clients    
			(
				Client
				P_le as "Groupe"
				Sous_d_nomination1 as "Siret"
				T_l_phone as "Téléphone GSM Contact"
				T_l_phone_Fixe_Site as "Téléphone GSM"
				Emailrs as "Email"
				Pr_nom_du_responsable as "Nom / Prénom"
				R_gions as "Régions"
				Adresse_pour_la_facturation  as "Adresse postale"
	 			(
	      			displayformat = [address_line_1+""+address_line_2+""+district_city+""+state_province+""+postal_Code+""+country]
	      			enable = Link_to_Map,Show_As_Text
	 			)
				CP_Filtre as "CP Filtre"
				Sous_d_nomination as "Type"
				Nom_du_responsable as "Nom du responsable"
				T_l_phone_du_site as "Téléphone du site (fixe)"
				Email_du_site as "Mail du site"
				En_sa_qualit_de as "Nom / Prénom responsable du site"
				Fonction_du_responsable_du_site as "Fonction du responsable du site"
				Contrat
				Num_ro_r_f_rence_du_contrat as "Numéro/référence du contrat"
				Expiration_renouvellement_du_contrat as "Expiration/renouvellement du contrat"
				Pi_ces_Comptables as "Pièces Comptables"
				(
					field = Pi_ces_Comptables.R_f_rence + " " + Pi_ces_Comptables.T_l_chargement_Fichier + " " + Pi_ces_Comptables.Type_Fichier
				)
			)
		}
		list DB_Tous_les_Clients
		{
			displayName = "Tous les Clients"
			print template = attestclient
			show all rows from Clients    
			(
				Client
				(
					width = 244px
				)
				Sous_d_nomination as "Type"
				Contrat
				Expiration_renouvellement_du_contrat as "Renouv. Contrat"
				(
					displayformat = fulldate
				)
				Nom_du_responsable as "Nom du responsable"
				Pr_nom_du_responsable as "Nom / Prénom"
				Emailrs as "Email"
				custom action "Afficher Défibrillateur(s)"
				(
	  			workflow = view_dae_per_client
				show action in edit record menu = true
				column header = "Afficher Défibrillateur(s)"
				)
				custom action "(PDF) Télécharger"
				(
	  			workflow = downloadatttestclient
				show action in edit record menu = true
				column header = "(PDF) Télécharger"
				confirmation before execution
				(
					message for individual record = "De quoi s'agit-il ? Il s'agit d'une preuve de registre au format PDF (1 page) dans le logiciel DéfibXpert pour le client ${Client}"
					confirm button text = "Télécharger"		
					cancel button text = "Retour"
				)
				)
				custom action "Voir Contrat(s)"
				(
	  			workflow = contractsee1
				show action in edit record menu = true
				column header = "Voir Contrat(s)"
				)
				Adresse_pour_la_facturation  as "CP"
	 			(
	      			displayformat = [postal_Code]
	      			enable = Show_As_Text
	 			)
				T_l_phone as "Téléphone"
				Num_ro_r_f_rence_du_contrat as "Numéro/référence du contrat"
				P_le as "Groupe"
				(
					width = 255px
				)
				Sous_d_nomination1 as "Siret"
				(
					width = 182px
				)
				En_sa_qualit_de as "Nom / Prénom responsable du site"
				Email_du_site as "Mail du site"
				T_l_phone_du_site as "Téléphone du site (fixe)"
				Fonction_du_responsable_du_site as "Fonction du responsable du site"
				Modified_Time as "Modified Time"
				CP_Filtre as "CP Filtre"
				T_l_phone_Fixe_Site as "Téléphone GSM"
				R_gions as "Régions"
				Pi_ces_Comptables as "Pièces Comptables"
				(
					field = Pi_ces_Comptables.T_l_chargement_Fichier + " " + Pi_ces_Comptables.R_f_rence
				)
			)
			group by
			(
				CP_Filtre ascending
			)
			sort by
			(
				Modified_Time descending
			)
			conditional formatting
			(
				"blue New Formatting"
				{
				fields = [Emailrs, T_l_phone]
				format = "color:#2f78d0;background-color:#e7f7fc;"
				}
				"New effe"
				{
				condition = (Expiration_renouvellement_du_contrat < zoho.currentdate)
				fields = [Expiration_renouvellement_du_contrat]
				format = "color:#ffffff;background-color:#ef1616;"
				}
				"deded"
				{
				condition = (Expiration_renouvellement_du_contrat in next 90 days)
				fields = [Expiration_renouvellement_du_contrat]
				format = "color:#ffffff;background-color:#ef8216;"
				}
				"New Formatting"
				{
				fields = [Sous_d_nomination, Adresse_pour_la_facturation]
				format = "color:#1378bd;background-color:#f2f2f2;"
				}
				"Tous (bleu)"
				{
				fields = [Client, P_le, Sous_d_nomination1, CP_Filtre]
				format = "color:#2d3b90;background-color:#f7f8ff;"
				}
			)
		}
		list DB_Tous_les_Clients1
		{
			displayName = "DB Tous les Clients"
			print template = attestclient
			show all rows from Clients    
			(
