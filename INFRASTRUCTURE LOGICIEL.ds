			{
				type =  form
				form = Interventions
				record event = on add or edit
					status = inactive

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.lectrode_chang_e == "Oui" || input.Batterie_chang_e == "Oui")
										{
											variable = insert into billingspace
											[
												Added_User=zoho.loginuser
												Statut_de_facturation=input.Statut_de_la_facturation
												G_n_ration="Depuis l'édition d'un rapport"
												Num_ro_de_la_pi_ce_comptable="Inconnu"
												Commentaires_libres="Aucun"
												Client=input.Client
												Num_ro_de_s_rie_du_d_fibrillateur=input.DAE_Num_ro_de_s_rieccc
												Date_Rapport=input.Date_de_derni_re_maintenance
												Contrat_hide=input.Contrat_pour_ce_d_fibrillateur1
												LinkIntervenant=input.Technicien9993
												Batterie_chang_e_2=input.Batterie_chang_e
												lectrode_chang_e_2=input.lectrode_chang_e
											];
										}
						)
					}
					actions 
					{
						custom deluge script
						(
											if(input.lectrode_chang_e == "Oui" || input.Batterie_chang_e == "Oui")
										{
											sendmail
											[
												from :"spilot@spenseignement.eu"
												to :"interv.defibrillateurs@spenseignement.eu","secretariat@spenseignement.eu","comptabilite@spenseignement.eu"
												subject :"Avertissement : Nouvelle ligne dans le Livre Comptable SPILOT à traiter"
