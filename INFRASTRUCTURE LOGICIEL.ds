		form Fichiers_m_dia
		{
			displayname = "Fichiers média"
			success message = "Enregistré"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Titre_du_fichier
			(
    			type = text
				displayname = "Titre du fichier"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Type_de_fichier
			(
				type = picklist
				displayname = "Type de fichier"
				maxchar = 100
				values = {"Zip","PDF","Doc","PSD","PNG","JPG/JPEG","Procreate","Autre"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			T_l_chargement
			(
    			type = upload file
				displayname = "Téléchargement"
				browse = local_drive
	 			row = 1
	 			column = 1   
				width = medium
			)
			Notes_internes
			(
    			type = textarea
				displayname = "Notes internes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Enregistrer
					(
   						type = submit
   						displayname = "Enregistrer"
					)
				}
				on edit
				{
					Mettre___jour
					(
   						type = submit
   						displayname = "Mettre à jour"
					)
					Annuler
					(
   						type = cancel
   						displayname = "Annuler"
					)
				}
			}
		}
		form contact_website
		{
			displayname = "Formulaire de contact Cardiac Safe"
			success message = "Demande envoyée"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Email
			(
    			type = email
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have T_l_phone
			(
    			type = phonenumber
				displayname = "Téléphone"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Name
			(
