				Pr_nom_du_responsable as "Nom / Prénom"
				Emailrs as "Email"
				custom action "Afficher Défibrillateur(s)"
				(
	  			workflow = view_dae_per_client
				show action in edit record menu = true
				column header = "Afficher Défibrillateur(s)"
				)
				custom action "(PDF) Télécharger"
				(
	  			workflow = downloadatttestclient
				show action in edit record menu = true
				column header = "(PDF) Télécharger"
				confirmation before execution
				(
					message for individual record = "De quoi s'agit-il ? Il s'agit d'une preuve de registre au format PDF (1 page) dans le logiciel DéfibXpert pour le client ${Client}"
					confirm button text = "Télécharger"		
					cancel button text = "Retour"
				)
				)
				custom action "Voir Contrat(s)"
				(
	  			workflow = contractsee1
				show action in edit record menu = true
				column header = "Voir Contrat(s)"
				)
				Adresse_pour_la_facturation  as "CP"
	 			(
	      			displayformat = [postal_Code]
	      			enable = Show_As_Text
	 			)
				T_l_phone as "Téléphone"
				Num_ro_r_f_rence_du_contrat as "Numéro/référence du contrat"
				P_le as "Groupe"
				(
					width = 255px
				)
				Sous_d_nomination1 as "Siret"
				(
					width = 182px
				)
				En_sa_qualit_de as "Nom / Prénom responsable du site"
				Email_du_site as "Mail du site"
				T_l_phone_du_site as "Téléphone du site (fixe)"
				Fonction_du_responsable_du_site as "Fonction du responsable du site"
				Modified_Time as "Modified Time"
				CP_Filtre as "CP Filtre"
