			sort by
			(
				Date_de_derni_re_maintenance ascending
			)
			custom actions
			(
				"Afficher les intervention(s)"
				(
	  			workflow = viewassocintervent
				show action in edit record menu = true
				)
				"Télécharger le PDF"
				(
	  			workflow = downloadreportdae
				show action in edit record menu = true
				confirmation before execution
				(
					message for individual record = "De quoi s'agit-il ? Il s'agit d'une preuve de registre au format PDF (1 page) dans le logiciel DéfibXpert pour le défibrillateur  ${DAE_Num_ro_de_s_rie}"
					confirm button text = "Télécharger"		
					cancel button text = "Retour"
				)
				)
				"Planifier une interv."
				(
	  			workflow = Prefillvisite
				show action in edit record menu = true
				condition = (DAE_Num_ro_de_s_rie is not null)
				confirmation before execution
				(
					message for individual record = "Souhaitez-vous créer une visite pour ce défibrillateur ?"
					confirm button text = "Oui"		
					cancel button text = "Non"
				)
				)
				"Contrat"
				(
	  			workflow = wherecontrat
				show action in edit record menu = true
				condition = (TypeReport.contains("Contrat"))
				)
				"Nouvelle Tournée"
				(
	  			workflow = tourneex
				show action in view header = true
				show action in edit record menu = true
				execute action for collection of records
				confirmation before execution
				(
					message for multiple records = "Les ${record_count} défibrillateurs seront ajoutés dans une nouvelle tournée."
					confirm button text = "Créer la Tournée"		
					cancel button text = "Retour"
				)
				)
				"Placer dans le Parc sans MAIN"
				(
	  			workflow = X10
				show action in view header = true
				show action in edit record menu = true
				confirmation before execution
				(
					message for multiple records = "Les ${record_count} défibrillateurs seront placés dans l'onglet 'Parc sans MAIN'"
					confirm button text = "Confirmer"		
					cancel button text = "Retour"
				)
				)
				"Intégrer à la Tournée Existante"
				(
	  			workflow = deziaduhzioufherzf
				show action in view header = true
				show action in edit record menu = true
				confirmation before execution
				(
					message for multiple records = "Le ou les défibrillateurs seront ajoutés aux tournées sélectionnées."
					confirm button text = "Confirmer"		
					cancel button text = "Annuler"
				)
				)
			)
			conditional formatting
			(
				"New Formatting"
				{
				fields = [Capacit_restante_de_l_lectrode_1, Capacit_restante_de_l_lectrode_2, Capacit_restante_de_l_lectrode_3]
				format = "font-weight:bold;color:#ffffff;background-color:#107c91;"
				}
				"ALL"
				{
				fields = [Date_de_mise_en_service, DAE_Num_ro_de_s_rie, Num_ro_de_lot, Pourcentage_de_la_batterie, Email_du_site, Localisation_de_l_appareilDAE, Client.Pr_nom_du_responsable, T_l_phone_principal]
				format = "color:#2d3b90;background-color:#f7f8ff;"
				}
				"Testoutdated"
				{
				condition = (Date_de_fin_de_garantie < zoho.currentdate)
				fields = [Date_de_fin_de_garantie]
				format = "color:#ffffff;background-color:#ef1616;"
				}
				"test3M"
				{
				condition = (Date_de_fin_de_garantie in next 90 days)
				fields = [Date_de_fin_de_garantie]
				format = "color:#ffffff;background-color:#ef8216;"
				}
				"outdapted batterie"
				{
				condition = (Fin_de_la_garantie_de_la_batterie < zoho.currentdate)
				fields = [Fin_de_la_garantie_de_la_batterie]
				format = "color:#ffffff;background-color:#ef1616;"
				}
				"oudated pér elec"
				{
				condition = (Date_de_p_remption_de_l_lectrode_1 < zoho.currentdate)
				fields = [Date_de_p_remption_de_l_lectrode_1]
				format = "color:#df2820;background-color:#ffeeed;"
				}
				"outdated batterie péremp"
				{
				condition = (michoucode < zoho.currentdate)
				fields = [michoucode]
				format = "color:#df2820;background-color:#ffeeed;"
				}
				"bientôt batterie"
				{
				condition = (Fin_de_la_garantie_de_la_batterie in next 90 days)
				fields = [Fin_de_la_garantie_de_la_batterie]
				format = "color:#ffffff;background-color:#ef8216;"
				}
				"beintôt electrode"
				{
				condition = (Date_de_p_remption_de_l_lectrode_1 in next 90 days)
				fields = [Date_de_p_remption_de_l_lectrode_1]
				format = "color:#cc6e11;background-color:#fff8e6;"
				}
				"bientpot date péremption batterie"
				{
				condition = (michoucode in next 90 days)
				fields = [michoucode]
				format = "color:#cc6e11;background-color:#fff8e6;"
				}
				"outdated elec 2"
				{
				condition = (Date_de_p_remption_de_l_lectrode_2 < zoho.currentdate)
				fields = [Date_de_p_remption_de_l_lectrode_2]
				format = "color:#ffffff;background-color:#ef1616;"
				}
				"élec out"
				{
				condition = (Date_de_p_remption_de_l_lectrode_3 < zoho.currentdate)
				fields = [Date_de_p_remption_de_l_lectrode_3]
				format = "color:#ffffff;background-color:#ef1616;"
				}
				"New aefezfe"
				{
				condition = (Date_de_p_remption_de_l_lectrode_2 in next 90 days)
				fields = [Date_de_p_remption_de_l_lectrode_2]
				format = "color:#ffffff;background-color:#ef8216;"
				}
				"New Formattingfezf"
				{
				condition = (Date_de_p_remption_de_l_lectrode_3 in next 90 days)
				fields = [Date_de_p_remption_de_l_lectrode_3]
				format = "color:#ffffff;background-color:#ef8216;"
				}
				"New oij"
				{
				condition = (Prochaine_visite < zoho.currentdate)
				fields = [Prochaine_visite]
				format = "color:#df2820;background-color:#ffeeed;"
				}
				"New ezf"
				{
				condition = (Prochaine_visite in next 90 days)
				fields = [Prochaine_visite]
				format = "color:#cc6e11;background-color:#fff8e6;"
				}
				"New Formatting"
				{
				fields = [Mod_le_d_appareil]
				format = "color:#2d3b90;background-color:#f7f8ff;"
				}
				"New Formatting"
				{
				condition = (Prochaine_visite > zoho.currentdate)
				fields = [Prochaine_visite]
				format = "color:#2d3b90;background-color:#f7f8ff;"
				}
				"New Formatting"
				{
				condition = (Prochaine_visite is null)
				fields = [Prochaine_visite]
				format = "color:#2d3b90;background-color:#f7f8ff;"
				}
				"New Formatting"
				{
				condition = (Date_de_p_remption_de_l_lectrode_1 is null)
				fields = [Date_de_p_remption_de_l_lectrode_1]
				format = "color:#2d3b90;background-color:#ebedfa;"
				}
				"New Formatting"
				{
				condition = (michoucode is null)
				fields = [michoucode]
				format = "color:#2d3b90;background-color:#f7f8ff;"
				}
				"New Formatting"
				{
				condition = (Date_de_p_remption_de_l_lectrode_1 > zoho.currentdate)
				fields = [Date_de_p_remption_de_l_lectrode_1]
				format = "color:#2d3b90;background-color:#ebedfa;"
				}
				"New Formatting"
				{
				condition = (michoucode > zoho.currentdate)
				fields = [michoucode]
				format = "color:#2d3b90;background-color:#f7f8ff;"
				}
				"New Formatting"
				{
				condition = (Prochaine_visite is today)
				fields = [Prochaine_visite]
				format = "color:#2d3b90;background-color:#f7f8ff;"
				}
				"New Formatting"
				{
				condition = (Date_de_p_remption_de_l_lectrode_1 is today)
				fields = [Date_de_p_remption_de_l_lectrode_1]
				format = "color:#2d3b90;background-color:#ebedfa;"
				}
				"New Formatting"
				{
				condition = (michoucode is today)
				fields = [michoucode]
				format = "color:#2d3b90;background-color:#f7f8ff;"
				}
				"A2"
				{
				fields = [Client, Rattachement_agence, Date_de_fabrication, Num_ro_de_lot_de_l_lectrode_1, Date_de_derni_re_maintenance, T_l_phone_du_site, CP_d_op_rations, Pr_nom_Nom_superviseur_du_site, Client.Emailrs, Enregistr_dans_G_oDae]
				format = "color:#2d3b90;background-color:#ebedfa;"
				}
				"New Formatting"
				{
				fields = [MiniCode1]
				format = "font-weight:bold;color:##1d508e;"
				}
			)
		}
		map Flotte_sur_le_territoire
		{
			displayName = "Map des DAE"
			show all rows from DAE    
			(
				Client as "Client associé à l'appareil"
				Coordonn_es_additionnelles as "Coordonnées additionnelles"
				Localisation_de_l_appareilDAE  as "Localisation de l'appareil"
	 			(
	      			displayformat = [address_line_1+""+address_line_2+""+district_city+""+postal_Code]
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Emplacement_de_l_appareil_dans_le_bpatiment as "Emplacement"
				Rattachement_agence as "Rattachement agence "
				Date_de_mise_en_service as "Date de mise en service du défibrillateur"
				Date_de_fabrication as "Date Fabrication DAE"
				Dur_e_de_garantie_de_l_appreil as "Durée de garantie du défibrillateur"
				Date_de_fin_de_garantie as "Date de fin de garantie de l'appareil"
				DAE_Num_ro_de_s_rie as "Numéro de série de l'appareil"
				Type_d_appareil as "Type"
				Mod_le_d_appareil as "Modèle d'appareil"
				Mod_le_bo_tier_mural as "Modèle Boîtier Mural"
				michoucode as "Date péremption de la batterie "
				Num_ro_de_lot as "Numéro Lot Batterie"
			)
			filters
			(
				Client
				Date_de_fin_de_garantie
				Rattachement_agence
				michoucode
				Date_de_p_remption_de_l_lectrode_1
			)
			options
			(
	 			display field = Localisation_de_l_appareilDAE
         		location
         		(
	 		 		latitude  = 48.8402969
	 		 		longitude = 2.3985393
         		)
	 	 		radius = 200 Miles
	 		)
			conditional formatting
			(
				"Une date est dépassée"
				{
				condition = (Date_de_p_remption_de_l_lectrode_1 in last 10000 days || michoucode in last 10000 days || Le_DAE_est_il_conforme == "Non")
				format = "color:#ef1616;map-icon:weather-moon-full;map-icon-color:#ffffff;"
				}
				"Tout est OK"
				{
				format = "color:#1c7d6c;map-icon:weather-moon-full;map-icon-color:#ffffff;"
				}
				"New Formattingddd"
				{
				condition = (Date_de_fin_de_garantie in last 10000 days || michoucode in last 10000 days || Fin_de_la_garantie_de_la_batterie in last 10000 days || Date_de_p_remption_de_l_lectrode_1 in last 10000 days || Le_DAE_est_il_conforme == "Non" || lectrode_1 == "À changer")
				fields = [DAE_Num_ro_de_s_rie]
				format = "font-weight:bold;color:#ffffff;background-color:#ef1616;"
				}
				"dezdzd"
				{
				condition = (Date_de_fin_de_garantie in last 10000 days || Fin_de_la_garantie_de_la_batterie in last 10000 days)
				format = "color:#7c7c7c;map-icon:weather-moon-full;map-icon-color:#ffffff;"
				}
			)
		}
