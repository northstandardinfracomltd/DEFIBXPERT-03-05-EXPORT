		form Create_Support_Request
		{
			title 
    		{
				displayname = "Create Support Request"
    			on add = "Créer une demande de support"
   	 			on edit = "Modifier la demande de support"
			}
			captcha = true
			success message = "Demande partagée à SAOECOM !"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Sorry
			(
				type = section
				displayname = "Envoyer une demande de support"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Qui_tes_vous_Nom_Pr_nom
			(
    			type = name
				displayname = "Qui êtes-vous ? (Nom, Prénom)"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="Prénom"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Nom"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
    			description
    			[
    				type = tooltip
    			 	message = "Nous aimerions personnaliser au mieux votre expérience d'aide"
    			]
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Phone_Number
			(
    			type = phonenumber
				displayname = "Sur quel numéro pouvons-nous vous joindre ?"
    			description
    			[
    				type = tooltip
    			 	message = "Nous pourrions être amené à vous appeler si nécessaire"
    			]
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Sur_quel_email_pouvons_nous_vous_crire
			(
    			type = email
				displayname = "Sur quel email pouvons-nous vous écrire ?"
    			description
    			[
    				type = tooltip
    			 	message = "Vous recevrez une copie notre réponse sur cet email"
    			]
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Please_describe_in_detail_what_happened
			(
    			type = textarea
				displayname = "Présentez votre demande en ajoutant tous les détails"
				height = 100px
    			description
    			[
    				type = tooltip
    			 	message = "Dites-nous en le plus possible"
    			]
	 			row = 2
	 			column = 1   
				width = medium
			)
			Snapshot
			(
    			type = image
				displayname = "Vous pouvez ajouter une copie d'écran ou un fichier"
				source  = public_url,file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
    			description
    			[
    				type = tooltip
    			 	message = "Partagez-nous un visuel pour améliorer la compréhension"
    			]
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Envoyer___Saoecom
					(
   						type = submit
   						displayname = "Envoyer à Saoecom"
					)
				}
				on edit
				{
					Modifier
					(
   						type = submit
   						displayname = "Modifier"
					)
				}
			}
		print template
			{
				R_c_piss_support
