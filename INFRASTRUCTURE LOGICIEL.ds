		form Cr_er_un_si_ge
		{
			displayname = "Créer un siège"
			store data in zc = false
			Structure
			(
				type = section
				displayname = "Structure et coordonnées"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Client
			(
    			type = text
				displayname = "Dénomination"
    			description
    			[
    				type = tooltip
    			 	message = "Il s'agit du nom commercial de la société (ex: Burger King, Leroy Merlin, Volkswagen, ...)"
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Pr_nom_du_responsable
			(
    			type = text
				displayname = "Prénom du responsable"
    			description
    			[
    				type = tooltip
    			 	message = "Avec qui SP Enseignement est en contact ?"
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Nom_du_responsable
			(
    			type = text
				displayname = "Nom du responsable"
    			description
    			[
    				type = tooltip
    			 	message = "Avec qui SP Enseignement est en contact ?"
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Email
			(
    			type = text
				displayname = "Email du siège social"
    			description
    			[
    				type = tooltip
    			 	message = "Contact prioritaire (probablement hors du cadre de la facturation)"
    			]
	 			row = 1
	 			column = 2   
				width = medium
