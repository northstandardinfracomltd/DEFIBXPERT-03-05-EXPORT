	     				  type = longitude
	     				  displayname = "longitude"
	     				 visibility = false
     				) 
					width = medium
					personal data = true
				)
				Emplacement
				(
    				type = textarea
					height = 100px
					width = medium
				)
				Semaine_de_Visite
				(
    				type = text
					displayname = "Semaine de Visite"
					initial value = "Semaine ?? du ??/?? au ??/?? "
					width = medium
				)
				Date_de_Visite
				(
