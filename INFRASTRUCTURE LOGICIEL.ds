				L_lectrode_2_est as "L'électrode 2 est"
				lectrode_1 as "Statut Électrode"
				Fin_de_la_garantie_de_la_batterie as "Garantie Batterie"
				Date_d_insertion_batterie as "Date Insertion Batterie"
				Num_ro_de_s_rie_AUIA as "Numéro de série AIUIA"
				Date_de_derni_re_maintenance as "Dernière Visite"
				(
					width = 151px
				)
				Le_DAE_est_il_conforme as "Statut conformité"
				Prochaine_visite as "Prochaine Visite"
				(
					width = 161px
					displayformat = fulldate
				)
				Emailrsx as "Email du franchisé"
				Pourcentage_de_la_batterie as "% Batterie"
				(
					width = 129px
				)
				Email_du_site as "Email (Site)"
				(
					width = 277px
				)
				T_l_phone_du_site as "Tél (Site)"
				(
					width = 125px
				)
				T_l_phone as "Téléphone du franchisé"
				P_le as "Groupe"
				Sous_d_nomination1 as "Structure associée"
				CP_d_op_rations as "CP"
				(
					width = 50px
				)
				Num_ro_de_lot_de_l_lectrode_p_diatrique as "Numéro Lot Électrode Enfant"
				Date_de_p_remption_de_l_lectrode_p_diatrique as "Date Péremption Électrode Enfant"
				Modified_Time as "Modified Time"
				Entit_gestionnaire as "Entité gestionnaire"
				Pr_nom_Nom_superviseur_du_site as "Contact (Site)"
				(
					width = 145px
				)
				Localisation_de_l_appareilDAE  as "Localisation"
	 			(
	      			displayformat = [address_line_1+""+address_line_2+""+district_city+""+state_province+""+postal_Code+""+country]
	      			enable = Link_to_Map,Show_As_Text
					width = 553px
	 			)
				custom action "Voir Contrat"
				(
	  			workflow = wherrrr
				show action in edit record menu = true
				column header = "Voir Contrat"
				condition = (TypeReport.contains("Contrat"))
				)
				custom action "Créer Visite"
				(
	  			workflow = leldeiodeded
				show action in edit record menu = true
				column header = "Créer Visite"
				condition = (DAE_Num_ro_de_s_rie is not null)
				)
				custom action "Voir Visite(s)"
				(
	  			workflow = deihfoef
				show action in edit record menu = true
				column header = "Voir Visite(s)"
				)
				Client.T_l_phone as "Tél (Client)"
				(
					width = 119px
				)
				custom action "(PDF) Télécharger"
				(
	  			workflow = deoiedoeed
				show action in edit record menu = true
				column header = "(PDF) Télécharger"
				confirmation before execution
				(
					message for individual record = "De quoi s'agit-il ? Il s'agit d'une preuve de registre au format PDF (1 page) dans le logiciel DéfibXpert pour le défibrillateur ${DAE_Num_ro_de_s_rie}"
					confirm button text = "Télécharger"		
					cancel button text = "Retour"
				)
				)
				Client.Emailrs as "Email (Client)"
				(
					width = 244px
				)
				custom action "Archivage"
				(
	  			workflow = eodhedhed
				show action in edit record menu = true
				column header = "Archivage"
				)
				Client.Pr_nom_du_responsable as "Contact (Client)"
				(
					width = 164px
				)
				Enregistr_dans_G_oDae as "Enr. Géo Dae"
				(
					width = 117px
				)
				Information_Adresse as "Site"
			)
			sort by
			(
				Modified_Time descending
			)
			custom actions
			(
				"Afficher les intervention(s)"
				(
	  			workflow = viewassocintervent
				show action in edit record menu = true
				)
				"Planifier une interv."
				(
	  			workflow = Prefillvisite
				show action in edit record menu = true
				condition = (DAE_Num_ro_de_s_rie is not null)
				confirmation before execution
				(
					message for individual record = "Souhaitez-vous créer une visite pour ce défibrillateur ?"
					confirm button text = "Oui"		
					cancel button text = "Non"
				)
				)
				"Contrat"
				(
	  			workflow = wherecontrat
				show action in edit record menu = true
				condition = (TypeReport.contains("Contrat"))
				)
				"Télécharger le PDF"
				(
	  			workflow = downloadreportdae
				show action in edit record menu = true
				confirmation before execution
				(
					message for individual record = "De quoi s'agit-il ? Il s'agit d'une preuve de registre au format PDF (1 page) dans le logiciel DéfibXpert pour le défibrillateur  ${DAE_Num_ro_de_s_rie}"
					confirm button text = "Télécharger"		
					cancel button text = "Retour"
				)
				)
				"Archiver"
				(
	  			workflow = archivagedae
				show action in edit record menu = true
				confirmation before execution
				(
					message for individual record = "Êtes-vous sûr de vouloir placer ce défibrillateur  ${DAE_Num_ro_de_s_rie} avec les archives ?"
					confirm button text = "Archiver"		
					cancel button text = "Retour"
				)
				)
			)
			conditional formatting
			(
				"New Formatting"
				{
				fields = [Capacit_restante_de_l_lectrode_1, Capacit_restante_de_l_lectrode_2, Capacit_restante_de_l_lectrode_3]
				format = "font-weight:bold;color:#ffffff;background-color:#107c91;"
				}
				"ALL"
				{
				fields = [Date_de_mise_en_service, DAE_Num_ro_de_s_rie, Num_ro_de_lot, Pourcentage_de_la_batterie, Email_du_site, Localisation_de_l_appareilDAE, Client.T_l_phone, Client.Pr_nom_du_responsable]
				format = "color:#2d3b90;background-color:#f7f8ff;"
				}
				"Testoutdated"
				{
				condition = (Date_de_fin_de_garantie < zoho.currentdate)
				fields = [Date_de_fin_de_garantie]
				format = "color:#ffffff;background-color:#ef1616;"
				}
				"test3M"
				{
				condition = (Date_de_fin_de_garantie in next 90 days)
				fields = [Date_de_fin_de_garantie]
				format = "color:#ffffff;background-color:#ef8216;"
				}
				"outdapted batterie"
				{
				condition = (Fin_de_la_garantie_de_la_batterie < zoho.currentdate)
				fields = [Fin_de_la_garantie_de_la_batterie]
				format = "color:#ffffff;background-color:#ef1616;"
				}
				"oudated pér elec"
				{
				condition = (Date_de_p_remption_de_l_lectrode_1 < zoho.currentdate)
				fields = [Date_de_p_remption_de_l_lectrode_1]
				format = "color:#df2820;background-color:#ffeeed;"
				}
				"outdated batterie péremp"
				{
				condition = (michoucode < zoho.currentdate)
				fields = [michoucode]
				format = "color:#df2820;background-color:#ffeeed;"
				}
				"bientôt batterie"
				{
				condition = (Fin_de_la_garantie_de_la_batterie in next 90 days)
				fields = [Fin_de_la_garantie_de_la_batterie]
				format = "color:#ffffff;background-color:#ef8216;"
				}
				"beintôt electrode"
				{
				condition = (Date_de_p_remption_de_l_lectrode_1 in next 90 days)
				fields = [Date_de_p_remption_de_l_lectrode_1]
				format = "color:#cc6e11;background-color:#fff8e6;"
				}
				"bientpot date péremption batterie"
				{
				condition = (michoucode in next 90 days)
				fields = [michoucode]
				format = "color:#cc6e11;background-color:#fff8e6;"
				}
				"outdated elec 2"
				{
				condition = (Date_de_p_remption_de_l_lectrode_2 < zoho.currentdate)
				fields = [Date_de_p_remption_de_l_lectrode_2]
				format = "color:#ffffff;background-color:#ef1616;"
				}
				"élec out"
				{
				condition = (Date_de_p_remption_de_l_lectrode_3 < zoho.currentdate)
				fields = [Date_de_p_remption_de_l_lectrode_3]
				format = "color:#ffffff;background-color:#ef1616;"
				}
				"New aefezfe"
				{
				condition = (Date_de_p_remption_de_l_lectrode_2 in next 90 days)
				fields = [Date_de_p_remption_de_l_lectrode_2]
				format = "color:#ffffff;background-color:#ef8216;"
				}
				"New Formattingfezf"
				{
				condition = (Date_de_p_remption_de_l_lectrode_3 in next 90 days)
				fields = [Date_de_p_remption_de_l_lectrode_3]
				format = "color:#ffffff;background-color:#ef8216;"
				}
				"New oij"
				{
				condition = (Prochaine_visite < zoho.currentdate)
				fields = [Prochaine_visite]
				format = "color:#df2820;background-color:#ffeeed;"
				}
				"New ezf"
				{
				condition = (Prochaine_visite in next 90 days)
				fields = [Prochaine_visite]
				format = "color:#cc6e11;background-color:#fff8e6;"
				}
				"New Formatting"
				{
				fields = [Mod_le_d_appareil]
				format = "color:#2d3b90;background-color:#f7f8ff;"
				}
				"New Formatting"
				{
				condition = (Prochaine_visite > zoho.currentdate)
				fields = [Prochaine_visite]
				format = "color:#2d3b90;background-color:#f7f8ff;"
				}
				"New Formatting"
				{
				condition = (Prochaine_visite is null)
				fields = [Prochaine_visite]
				format = "color:#2d3b90;background-color:#f7f8ff;"
				}
				"New Formatting"
				{
				condition = (Date_de_p_remption_de_l_lectrode_1 is null)
				fields = [Date_de_p_remption_de_l_lectrode_1]
				format = "color:#2d3b90;background-color:#ebedfa;"
				}
				"New Formatting"
				{
				condition = (michoucode is null)
				fields = [michoucode]
				format = "color:#2d3b90;background-color:#f7f8ff;"
				}
				"New Formatting"
				{
				condition = (Date_de_p_remption_de_l_lectrode_1 > zoho.currentdate)
				fields = [Date_de_p_remption_de_l_lectrode_1]
				format = "color:#2d3b90;background-color:#ebedfa;"
				}
				"New Formatting"
				{
				condition = (michoucode > zoho.currentdate)
				fields = [michoucode]
				format = "color:#2d3b90;background-color:#f7f8ff;"
				}
				"New Formatting"
				{
				condition = (Prochaine_visite is today)
				fields = [Prochaine_visite]
				format = "color:#2d3b90;background-color:#f7f8ff;"
				}
				"New Formatting"
				{
				condition = (Date_de_p_remption_de_l_lectrode_1 is today)
				fields = [Date_de_p_remption_de_l_lectrode_1]
				format = "color:#2d3b90;background-color:#ebedfa;"
				}
				"New Formatting"
				{
				condition = (michoucode is today)
				fields = [michoucode]
				format = "color:#2d3b90;background-color:#f7f8ff;"
				}
				"A2"
				{
				fields = [Client, Rattachement_agence, Date_de_fabrication, Num_ro_de_lot_de_l_lectrode_1, Date_de_derni_re_maintenance, T_l_phone_du_site, CP_d_op_rations, Pr_nom_Nom_superviseur_du_site, Client.Emailrs, Enregistr_dans_G_oDae]
				format = "color:#2d3b90;background-color:#ebedfa;"
				}
			)
		}
