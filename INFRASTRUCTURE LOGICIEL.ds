				maxchar = 3
				initial value = 0
    			description
    			[
    				type = help_text
    			 	message = "Prix TTC /Unité de 50€"
    			]
	 			row = 2
	 			column = 1   
				width = 35px
			)
			D_tails_de_la_Commande
			(
				type = section
				displayname = "Détails de la Commande"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Livraison_Domicile
			(
				type = radiobuttons
				displayname = "Configuration de ma Livraison"
				maxchar = 100
				values = {"Livraison Standard (Frais de 12€)"}
				initial value = "Livraison Standard (Frais de 12€)"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Adresse_de_Livraison_du_Colis
			(
    			type = address
				displayname = "Adresse de Livraison du Colis"
     			capture_coordinates = false
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Numéro et Voie"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
	     			 visibility = false
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "Ville"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
	     			 visibility = false
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Code Postal"
     			) 
