				(
					width = 132px
				)
				Capacit_restante_de_l_lectrode_1 as "Capacité électrode 1"
				Capacit_restante_de_l_lectrode_2 as "Capacité électrode 2"
				Capacit_restante_de_l_lectrode_3 as "Capacité électrode 3"
				Num_ro_de_lot_de_l_lectrode_1 as "Lot Électrode"
				(
					width = 152px
				)
				Num_ro_de_lot_de_l_lectrode_2 as "Numéro de lot de l'électrode 2"
				Num_ro_de_lot_de_l_lectrode_3 as "Numéro de lot de l'électrode 3"
				Date_de_p_remption_de_l_lectrode_1 as "Pér. Électrode"
				(
