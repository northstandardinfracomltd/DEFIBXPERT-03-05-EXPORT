				condition = (Prochaine_visite > zoho.currentdate)
				fields = [Prochaine_visite]
				format = "color:#2d3b90;background-color:#f7f8ff;"
				}
				"New Formatting"
				{
				condition = (Prochaine_visite is null)
				fields = [Prochaine_visite]
				format = "color:#2d3b90;background-color:#f7f8ff;"
				}
				"New Formatting"
				{
				condition = (Date_de_p_remption_de_l_lectrode_1 is null)
				fields = [Date_de_p_remption_de_l_lectrode_1]
				format = "color:#2d3b90;background-color:#ebedfa;"
				}
				"New Formatting"
				{
				condition = (michoucode is null)
				fields = [michoucode]
				format = "color:#2d3b90;background-color:#f7f8ff;"
				}
				"New Formatting"
				{
				condition = (Date_de_p_remption_de_l_lectrode_1 > zoho.currentdate)
				fields = [Date_de_p_remption_de_l_lectrode_1]
				format = "color:#2d3b90;background-color:#ebedfa;"
				}
				"New Formatting"
				{
				condition = (michoucode > zoho.currentdate)
				fields = [michoucode]
				format = "color:#2d3b90;background-color:#f7f8ff;"
				}
				"New Formatting"
				{
				condition = (Prochaine_visite is today)
				fields = [Prochaine_visite]
				format = "color:#2d3b90;background-color:#f7f8ff;"
				}
				"New Formatting"
				{
				condition = (Date_de_p_remption_de_l_lectrode_1 is today)
				fields = [Date_de_p_remption_de_l_lectrode_1]
				format = "color:#2d3b90;background-color:#ebedfa;"
				}
				"New Formatting"
				{
				condition = (michoucode is today)
				fields = [michoucode]
				format = "color:#2d3b90;background-color:#f7f8ff;"
				}
				"ddd"
				{
				condition = (TypeReport.contains("Contrat"))
				fields = [TypeReport]
				format = "color:#4ea64c;background-color:#4ea64c;"
				}
				"New jjj"
				{
				condition = (!TypeReport.contains("Contrat"))
				fields = [TypeReport]
				format = "color:#ef1616;background-color:#ef1616;"
				}
				"A2"
				{
				fields = [Client, Rattachement_agence, Date_de_fabrication, Num_ro_de_lot_de_l_lectrode_1, Date_de_derni_re_maintenance, T_l_phone_du_site, CP_d_op_rations, Pr_nom_Nom_superviseur_du_site, Client.Emailrs, Enregistr_dans_G_oDae]
				format = "color:#2d3b90;background-color:#ebedfa;"
				}
			)
