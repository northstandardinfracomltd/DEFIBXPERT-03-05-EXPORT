				R_f_rence_pi_ce_comptable as "Référence pièce comptable"
				(
					width = 220px
				)
				Produit_en_facturation.Tarif_TTC_unitaire as "Montant HT Valeur Achat (Unitaire)"
				(
					width = 160px
				)
				Client_en_facturation.Added_Time as "Date de notification"
				(
					width = 160px
				)
				Client_en_facturation.Sous_d_nomination as "Type"
			)
			conditional formatting
			(
				"dedeaofezf"
				{
				condition = (Statut_de_la_facturation == "À facturer" || Statut_de_la_facturation == "En attente ou à définir")
				fields = [Statut_de_la_facturation]
				format = "color:#ef1616;background-color:#fce7e7;"
				}
				"efzfezf"
				{
				condition = (Statut_de_la_facturation == "Traité par le service comptable (terminé)")
				fields = [Statut_de_la_facturation]
				format = "color:#2f78d0;background-color:#e8eefd;"
				}
				"shqreh"
				{
				condition = (Statut_de_la_facturation == "Facture envoyée" || Statut_de_la_facturation == "Facture payée")
				fields = [Statut_de_la_facturation]
				format = "color:#2f78d0;background-color:#e8eefd;"
				}
				"Product"
				{
				fields = [Produit_en_facturation, Quantit_utilis_e, Produit_en_facturation.Tarif_TTC_unitaire]
				format = "color:#2f78d0;background-color:#e8eefd;"
				}
				"Customer"
				{
				fields = [Client_en_facturation, R_f_rence_pi_ce_comptable, Client_en_facturation.Added_Time]
				format = "color:#a811cc;background-color:#f5e7fc;"
				}
				"New Formatting"
				{
				condition = (R_f_rence_pi_ce_comptable == "À définir")
				fields = [R_f_rence_pi_ce_comptable]
				format = "color:#ef1616;background-color:#fce7e7;"
				}
				"New Formatting"
				{
				fields = [Client_en_facturation, Client_en_facturation.Sous_d_nomination]
				format = "font-weight:bold;color:#ffffff;background-color:#1378bd;"
				}
			)
		}
		default custom Communication_client_Report
		{
