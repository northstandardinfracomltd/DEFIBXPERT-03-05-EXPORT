				(
	  			workflow = babababaaaa
				show action in edit record menu = true
				column header = "Clôturer"
				condition = (Statut_de_facturation != "Payée / Terminée")
				confirmation before execution
				(
					message for individual record = "En poursuivant, cette ligne comptable va être marquée comme payée ou terminée"
					confirm button text = "Oui"		
					cancel button text = "Annuler"
