		default list contact_website_Report
		{
			displayName = "Demandes Formulaire"
			show all rows from contact_website    
			(
				Email
				T_l_phone as "Téléphone"
				(
					displayformat = plainnumber 
					linktodial = enable
				)
				Name 
	 			(
	      			displayformat = [first_name+""+prefix+""+last_name+""+suffix]
	 			)
				Renseignez_votre_demande as "Renseignez votre demande"
			)
		}
