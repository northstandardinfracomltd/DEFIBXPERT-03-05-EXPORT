				format = "color:#cc1111;background-color:#f2f2f2;"
				}
				"zefezff"
				{
				condition = (Statut == "Mettre en attente")
				fields = [Statut]
				format = "color:#cc9711;background-color:#f2f2f2;"
				}
				"effgazeg"
				{
				condition = (Statut == "Clôturée avec succès")
				fields = [Statut]
				format = "color:#1378bd;background-color:#f2f2f2;"
				}
				"aezfezaf"
				{
				condition = (Statut == "Annulation")
				fields = [Statut]
				format = "color:#1378bd;background-color:#f2f2f2;"
				}
				"zeafgezgf"
				{
				condition = (Statut == "Attention requise")
				fields = [Statut]
				format = "color:#cc1111;background-color:#f2f2f2;"
				}
				"New Formattingaezfeazf"
				{
				condition = (Statut_de_Facturation == "Facture à envoyer")
				fields = [Statut_de_Facturation]
				format = "color:#ffffff;background-color:#ef1616;"
				}
				"New Forezfefmatting"
				{
				condition = (Statut_de_Facturation == "Facture envoyée")
				fields = [Statut_de_Facturation]
				format = "color:#ffffff;background-color:#ef8216;"
				}
				"New Formdedattingdeded"
				{
				condition = (Statut_de_Facturation == "Facture payée")
				fields = [Statut_de_Facturation]
				format = "color:#ffffff;background-color:#5dc35a;"
				}
				"New Formatting ALL"
				{
				fields = [Localisation_de_l_appareilDAE, Client, Date_de_derni_re_maintenance, Heure_de_l_intervention, DAE_Num_ro_de_s_rie, Mod_le_d_appareil, Ajouter_une_photo, quelle_heure_avez_vous_cl_tur_l_intervention, Technicien9993]
				format = "color:#2d3b90;background-color:#f7f8ff;"
				}
			)
		}
		list D_fibrillateurs_en_Sous_Traitance
		{
			displayName = "Défibrillateurs en Sous Traitance"
