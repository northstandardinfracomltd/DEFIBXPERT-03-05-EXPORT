				Commentaire_s.Titre_du_commentaire as "Commentaire(s)"
				Image_optionnel as "Image (optionnel)"
				Fichier_optionnel as "Fichier"
				Statut
				custom action "Refuser"
				(
	  			workflow = refuseidea
				show action in edit record menu = true
				column header = "Refuser"
				condition = (Statut != "Refusé" || Statut != "Validé" || Statut != "Terminé")
				)
				custom action "Accepter"
				(
	  			workflow = acceptidea
				show action in edit record menu = true
				column header = "Accepter"
				condition = (Statut == "Nouveau" || Statut == "Brouillon")
				)
			)
			conditional formatting
			(
				"validé"
				{
				condition = (Statut == "Validé")
				fields = [Statut]
				format = "color:#5dc35a;background-color:#f5faf5;"
				}
				"Terminé"
				{
				condition = (Statut == "Terminé")
				fields = [Statut]
				format = "color:#595959;background-color:#f3f3f3;"
				}
				"Refus"
				{
				condition = (Statut == "Refusé")
				fields = [Statut]
				format = "color:#ef1616;background-color:#fdf4f4;"
				}
				"draft"
				{
				condition = (Statut == "Brouillon" || Statut == "Nouveau")
				fields = [Statut]
				format = "color:#ef8216;background-color:#fdf9f4;"
				}
			)
		}
