		form Tourn_e
		{
			displayname = "Édition de la Tournée"
			success message = "Enregistré"
			Informations
			(
				type = section
				displayname = "Propriétés"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Statut
			(
				type = picklist
				maxchar = 100
				values = {"Nouvelle Tournée","Tournée en Préparation","Tournée Prête","Tournée Annulée","Tournée Terminée"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Titre
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Date_de_Visite
			(
    			type = date
				displayname = "Date de Visite"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Semaine_de_Visite
			(
    			type = text
				displayname = "Semaine de Visite"
				initial value = "Semaine ?? du ??/?? au ??/?? "
	 			row = 1
	 			column = 1   
				width = medium
			)
			Dupliquer_la_Date
			(
				type = radiobuttons
				displayname = "Dupliquer la Date"
				maxchar = 100
				values = {"Oui"}
    			description
    			[
    				type = help_text
    			 	message = "Utiliser la date pour toutes les visites."
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
			plain
			(
    			type = plaintext
				value = "<div><div><br /></div><div><br /></div></div><div><br /></div>"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Technicien1
