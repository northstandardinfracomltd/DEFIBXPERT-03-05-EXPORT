	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 3
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Email_Confirmation_Suivi_Commande
			(
    			type = email
				displayname = "Email"
				initial value = "defibrillateur@cardiacsafe.fr"
				maxchar = 80
    			description
    			[
    				type = help_text
    			 	message = "Utilisé pour la confirmation et le suivi de la commande."
    			]
	 			row = 3
	 			column = 1   
				width = 500px
				personal data = true
			)
	
			actions
			{
				on add
