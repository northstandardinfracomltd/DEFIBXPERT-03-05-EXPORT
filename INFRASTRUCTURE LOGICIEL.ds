				format = "color:#2d3b90;background-color:#f7f8ff;"
				}
				"null"
				{
				condition = (Je_valide_et_confirme_la_formation is null)
				format = "color:#df2820;background-color:#df2820;"
				}
				"nulllll"
				{
				condition = (Je_valide_et_confirme_la_formation is null)
				fields = [Je_valide_et_confirme_la_formation]
				format = "color:#df2820;background-color:#df2820;"
				}
				"greeeeen"
				{
				condition = (Je_valide_et_confirme_la_formation == "Oui")
				fields = [Je_valide_et_confirme_la_formation]
				format = "color:#009640;background-color:#009640;"
				}
			)
		}
