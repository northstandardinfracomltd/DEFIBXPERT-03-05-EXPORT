		form contract
		{
			title 
    		{
				displayname = "Nouveau Contrat"
    			on add = "Nouveau Contrat DéfibXpert"
   	 			on edit = "Contrat avec Cardiac Safe"
			}
			success message = "Contrat Enregistré dans DéfibXpert"
			Informations_g_n_rales
			(
				type = section
				displayname = "Renseignements"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have contract_choice
			(
				type = picklist
				displayname = "Type / Titre Contrat"
				maxchar = 100
				values = {"CONVENTION DE PARTENARIAT DE MAINTENANCE","CONVENTION DE PARTENARIAT DE MAINTENANCE TOUT COMPRIS","CONVENTION DE PARTENARIAT DE LOCATION"}
	 			row = 1
	 			column = 1   
				width = 500px
			)
			Statutenvoi
			(
				type = picklist
				maxchar = 100
				values = {"Non envoyé","Envoyé","Inconnu"}
				private = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Titre_du_contrat
			(
    			type = text
				displayname = "Titre Contrat"
				initial value = "CONTRAT DE MAINTENANCE"
    			description
    			[
    				type = none
    			 	message = "Le numéro de contrat est généré automatiquement"
    			]
				private = true
	 			row = 1
	 			column = 1   
				width = 500px
			)
			R_f_rence_du_contrat
			(
    			type = autonumber
				displayname = "Numéro de contrat C00___-2023"
				start index = 27
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Date_de_g_n_ration
			(
    			type = date
				displayname = "Date Génération Initiale"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = 500px
			)
			Statut_du_contrat
			(
				type = picklist
				displayname = "Statut du contrat"
				maxchar = 100
				values = {"Généré","Signé","Résilié","À renouveler","Envoyé"}
				initial value = "Généré"
				private = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Mode_de_signature
			(
				type = picklist
				displayname = "Mode Signature"
				maxchar = 100
				values = {"En ligne","Hors ligne"}
				initial value = "En ligne"
	 			row = 1
	 			column = 1   
				width = 150px
			)
			Valeur_Contrat_HT
			(
				type = decimal
				displayname = "Valeur Contrat HT (Statistiques)"
	 			row = 1
	 			column = 1   
				width = 150px
			)
			Montant_Contrat_Statistiques
			(
				type = decimal
				displayname = "Montant Contrat TTC (Statistiques)"
				private = true
	 			row = 1
	 			column = 1   
				width = 100px
				isephi = true
			)
			Entre
			(
				type = section
				displayname = "Client"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Client
			(
				type = picklist	
				values  = Clients.ID
    			displayformat = [Client]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = 500px
			)
			P_le
			(
    			type = text
				displayname = "Groupe"
	 			row = 2
	 			column = 1   
				width = 500px
			)
			Sous_d_nomination1
			(
    			type = text
				displayname = "Siret"
	 			row = 2
	 			column = 1   
				width = 500px
			)
			must have Emailrs
			(
    			type = email
				displayname = "Email Franchisé"
				maxchar = 80
	 			row = 2
	 			column = 1   
				width = 500px
				personal data = true
			)
			Email_du_site
			(
    			type = email
				displayname = "Email Site"
				maxchar = 80
	 			row = 2
	 			column = 1   
				width = 500px
				personal data = true
			)
			Pr_nom_du_responsable
			(
    			type = text
				displayname = "Nom / Prénom Client Signataire"
	 			row = 2
	 			column = 1   
				width = 500px
			)
			Nom_du_responsable
			(
    			type = text
				displayname = "Nom"
				private = true
	 			row = 2
	 			column = 1   
				width = medium
			)
			En_sa_qualit_de
			(
    			type = text
				displayname = "Fonction Client Signataire"
	 			row = 2
	 			column = 1   
				width = 500px
			)
			Adresse_pour_la_facturation
			(
    			type = address
				displayname = "Adresse"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "N° Rue"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Adresse ligne 2"
	     			 visibility = false
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "Ville"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "Région"
	     			 visibility = false
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "CP"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Pays"
	     			 visibility = false
     			) 
     			latitude
     			(
	     			  type = latitude
