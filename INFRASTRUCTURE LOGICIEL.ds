				T_l_Technicien as "Tél"
				(
					displayformat = plainnumber 
					linktodial = enable
				)
				D_fibrillateur_s.N_S_rie as "Défibrillateur(s)"
				Inform_s_Le_hide as "Informés Le"
				(
					width = 142px
				)
				Missionn_Le as "Missionés Le"
				(
					width = 144px
				)
				custom action "1/3 Générer Autorisations"
				(
	  			workflow = X6
				show action in edit record menu = true
				column header = "1/3 Générer Autorisations"
				condition = (Semaine_de_Visite is not null)
				confirmation before execution
				(
					message for individual record = "Exécuter l’action 1/3 Générer Autorisations pour cet enregistrement ?"
					confirm button text = "Oui"		
					cancel button text = "Non"
				)
				)
				Autoris_s_Le_hide as "Autorisés Le"
				(
					width = 139px
				)
				custom action "2/3 Informer les Clients"
				(
	  			workflow = X7
				show action in edit record menu = true
				column header = "2/3 Informer les Clients"
				condition = (Autoris_s_Le_hide is not null)
				confirmation before execution
				(
					message for individual record = "Exécuter l’action 2/3 Informer les Clients pour cet enregistrement ?"
					confirm button text = "Oui"		
					cancel button text = "Non"
				)
				)
				custom action "3/3 Missioner le Technicien"
				(
	  			workflow = X8
				show action in edit record menu = true
				column header = "3/3 Missioner le Technicien"
				condition = (Inform_s_Le_hide is not null)
				confirmation before execution
				(
					message for individual record = "Exécuter l’action 3/3 Missioner le Technicien pour cet enregistrement ?"
					confirm button text = "Oui"		
					cancel button text = "Non"
				)
				)
				custom action "Télécharger PDF"
				(
	  			workflow = X9
				show action in edit record menu = true
				column header = "Télécharger PDF"
				condition = (Autoris_s_Le_hide is not null)
				confirmation before execution
				(
					message for individual record = "Exécuter l’action Télécharger PDF pour cet enregistrement ?"
					confirm button text = "Oui"		
					cancel button text = "Non"
				)
				)
				Semaine_de_Visite as "Semaine Visite"
				(
					width = 253px
				)
			)
			filters
			(
				"Tournées Terminées"  :  Statut == "Tournée Terminée" || Statut == "Tournée Annulée"
				"Tournées en Édition"  :  Statut == "Nouvelle Tournée" || Statut == "Tournée en Préparation"
				"Tournées en Cours"  :  Statut == "Tournée Prête"
			)
			group by
			(
				Date_de_Visite ascending
			)
			sort by
			(
				Statut ascending
			)
			conditional formatting
			(
				"CLOSED"
				{
				condition = (Statut == "Tournée Terminée")
				fields = [Statut, Technicien, Titre, Inform_s_Le_hide, Missionn_Le, Autoris_s_Le_hide, Semaine_de_Visite]
				format = "color:#aaaaaa;background-color:#f3f3f3;"
				}
				"READY"
				{
				condition = (Statut == "Tournée Prête")
				fields = [Statut, Technicien, Titre, Inform_s_Le_hide, Missionn_Le, Autoris_s_Le_hide, Semaine_de_Visite]
				format = "color:#72b370;background-color:#f5faf5;"
				}
			)
		}
