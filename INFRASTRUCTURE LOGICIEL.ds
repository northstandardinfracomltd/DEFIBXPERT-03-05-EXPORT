			Test_autofill3 as "Test autofill"
			{
				type =  form
				form = TESt1
				record event = on add or edit
					status = inactive

				on user input of DAE_Num_ro_de_s_rie
				{
					actions 
					{
						custom deluge script
						(
											if(DAE[ID == input.DAE_Num_ro_de_s_rie].count() > 0)
										{
											temp = Interventions[ID == input.Client];
											input.Client = temp.Client;
										}
						)
					}
				}

			}
			Fetch_and_Auto_populate_C3 as "Fetch and Auto-populate Client"
			{
				type =  form
				form = TESt1
				record event = on add or edit

				on user input of DAE_Num_ro_de_s_rie
				{
					actions 
					{
						custom deluge script
						(
											DAERec = DAE[ID == input.DAE_Num_ro_de_s_rie];
										input.Client = DAERec.Client;
										input.Localisation_de_l_appareilDAE = DAERec.Localisation_de_l_appareilDAE;
										input.Emplacement_de_l_appareil_dans_le_bpatiment = DAERec.Emplacement_de_l_appareil_dans_le_bpatiment;
										input.Type_d_appareil = DAERec.Type_d_appareil;
										input.Mod_le_d_appareil = DAERec.Mod_le_d_appareil;
										input.Mod_le_bo_tier_mural = DAERec.Mod_le_bo_tier_mural;
										input.Date_de_fabrication = DAERec.Date_de_fabrication;
										input.Num_ro_de_lot = DAERec.Num_ro_de_lot;
										input.Fin_de_la_garantie_de_la_batterie = DAERec.Fin_de_la_garantie_de_la_batterie;
										input.Date_d_insertion_batterie = DAERec.Date_d_insertion_batterie;
										input.Num_ro_de_s_rie_AUIA = DAERec.Num_ro_de_s_rie_AUIA;
										input.Num_ro_de_lot_de_l_lectrode_1 = DAERec.Num_ro_de_lot_de_l_lectrode_1;
