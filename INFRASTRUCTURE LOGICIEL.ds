ment":{"imageId":"img_8035621599999905","size":"M","src":"https://creator.zoho.eu/appbuilder/safe.roeschronan.ccspublisher/spilot/downLoadImage?imgFileId=2940678000000002014&imgFileName=1661121863374_LOGO-CLEAR.png","captionMargin":"0px auto","alt":"","caption":"","id":"u_elem_8021189099999905","align":"center","elemStyle":"border: 0px solid rgb(169, 169, 169); margin-top: 5px; padding-left: 8px; width: 300px","formCompId":""}}]}]}}]}]}}],"style":"border-color: rgb(255, 255, 255); background-color: rgb(255, 255, 255)","bgImg":""},"themeFont":"lato","isHeaderEnabled":true}
				}
