		form testing_signature
		{
			displayname = "testing signature"
			success message = "Les données ont été ajoutées avec succès!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			contract
			(
				type = picklist	
				values  = contract.ID
    			displayformat = [R_f_rence_du_contrat]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Signature
			(
    			type = signature
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Soumettre"
					)
					reset
					(
   						type = reset
   						displayname = "Réinitialiser"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Mettre à jour"
					)
					cancel
					(
   						type = cancel
   						displayname = "Annuler"
					)
				}
			}
		}
		form VAB_1
		{
			title 
    		{
				displayname = "VAB-1"
    			on add = "Création intervention sur un DAE"
   	 			on edit = "Modification intervention sur un DAE"
			}
			success message = "Enregistré"
			Section
			(
				type = section
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Intervenant_s
			(
				type = list	
				displayname = "Intervenant(s) sur la visite"
				values  = Intervenants.ID
    			displayformat = [Nomooo92]
				sortorder = ascending
				height = 60px
    			description
    			[
    				type = tooltip
    			 	message = "Qui est en charge de l'intervention"
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Date_pr_vue_visite
			(
    			type = date
				displayname = "Date prévue visite"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have DAE_Num_ro_de_s_rie
			(
				type = picklist	
				displayname = "N° de série"
				values  = DAE.ID
    			displayformat = [DAE_Num_ro_de_s_rie]
				sortorder = ascending
    			description
    			[
    				type = tooltip
    			 	message = "Rennseignez le numéro de série communiqué par SP ENSEIGNEMENT. Les données connues seront ainsi immédiatement remplies."
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Note_l_intervenant
			(
    			type = textarea
				displayname = "Note à l'intervenant"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Prise_en_charge
			(
				type = section
				displayname = "Prise en charge"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Date_de_derni_re_maintenance
			(
    			type = date
				displayname = "Date début visite"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
    			description
    			[
    				type = tooltip
    			 	message = "Quand a lieu l'intervention ?"
    			]
				private = true
	 			row = 2
	 			column = 1   
				width = medium
			)
			Heure_de_l_intervention
			(
    			type = time
				displayname = "Horaire début visite"
				initial value = "${zoho.currenttime}"	
				timedisplayoptions = "hh:mm" 
    			description
    			[
    				type = tooltip
    			 	message = "Quelle est l'heure d'intervention ?"
    			]
				private = true
	 			row = 2
	 			column = 1   
				width = medium
			)
			Communication_automatique
			(
				type = section
				displayname = "Communication du rapport pdf"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Sur_quel_email_devons_nous_envoyer_un_re_u_automatique
			(
    			type = email
				displayname = "Email client"
				maxchar = 80
    			description
    			[
    				type = help_text
    			 	message = "Utilisé pour envoyer un rapport PDF"
    			]
				private = true
	 			row = 3
	 			column = 1   
				width = medium
				personal data = true
			)
			Autre_email_si_n_cessaire
			(
    			type = email
				displayname = "Autre email si nécessaire (Intervenant)"
				maxchar = 80
				private = true
	 			row = 3
	 			column = 1   
				width = medium
				personal data = true
			)
