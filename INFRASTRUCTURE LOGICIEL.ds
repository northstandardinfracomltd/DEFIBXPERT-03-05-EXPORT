				 void defaultFunction(DAE obj)
                 {
                 	col = Collection();
                 	for each  rec in obj
                 	{
                 		r = Tourn_e.D_fibrillateur_s();
                 		r.Adresse_D_fibrillateur.address_line_1=rec.Localisation_de_l_appareilDAE.address_line_1;
                 		r.Adresse_D_fibrillateur.address_line_2=rec.Localisation_de_l_appareilDAE.address_line_2;
                 		r.Adresse_D_fibrillateur.district_city=rec.Localisation_de_l_appareilDAE.district_city;
                 		r.Adresse_D_fibrillateur.postal_Code=rec.Localisation_de_l_appareilDAE.postal_Code;
                 		r.Adresse_D_fibrillateur.state_province=rec.Localisation_de_l_appareilDAE.state_province;
                 		r.Adresse_D_fibrillateur.country=rec.Localisation_de_l_appareilDAE.country;
                 		r.N_S_rie=rec.DAE_Num_ro_de_s_rie;
                 		r.MiniRef=rec.MiniCode1;
                 		r.Email_Client=rec.Email_client_notifications;
                 		r.Client=rec.Information_Adresse;
                 		r.Tel_Client=rec.T_l_phone_du_site;
                 		r.Emplacement=rec.Emplacement_de_l_appareil_dans_le_bpatiment;
                 		r.Date_P_remption_Batterie=rec.michoucode;
                 		r.Date_P_remption_lectrode=rec.Date_de_p_remption_de_l_lectrode_1;
                 		r.Date_P_remption_lectrode_Enfant=rec.Date_de_p_remption_de_l_lectrode_p_diatrique;
                 		r.Type_field="Maintenance";
                 		r.Semaine_de_Visite="Semaine ?? du ??/?? au ??/??";
                 		col.insert(r);
                 	}
                 	res = insert into Tourn_e
                 	[
                 		Titre="Nouvelle Tournée Sans Titre"
                 		Statut="Nouvelle Tournée"
                 		Semaine_de_Visite="Semaine ?? du ??/?? au ??/??"
                 		Added_User=zoho.loginuser
                 		D_fibrillateur_s=col
                 	];
                 	for each  rec in obj
                 	{
                 		rec.Statut_Visite="Ajouté à une Tournée";
                 	}
                 	openUrl("#Report:Tourn_e_Report","same window");
                 }
