										input.Pourcentage_de_la_batterie = DAERec.Pourcentage_de_la_batterie;
										input.Nouveau_N_S_rie = DAERec.DAE_Num_ro_de_s_rie;
										input.Date_de_fin_de_garantie = DAERec.Date_de_fin_de_garantie;
