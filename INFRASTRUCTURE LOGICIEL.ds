		workflow
		{
		form
		{
			Changement_de_statut_en_f1 as "Changement de statut en fonction de la quantité 2"
			{
				type =  form
				form = Inventaire
				record event = on edit

				on success
				{
					actions  (Quantit_en_stock == 0)
					{
					update Inventaire[Statut == "Épuisé"]
					[
						Statut = "Épuisé"
					]
					}
				}

			}
			Changement_de_statut_en_f as "Changement de statut en fonction de la quantité 3"
			{
				type =  form
				form = Inventaire
				record event = on edit

				on success
				{
					actions  (Quantit_en_stock >= 1)
					{
					update Inventaire[ID == input.ID]
					[
						Statut = "En stock"
					]
					}
				}

			}
			Test_autofill as "Test autofill"
			{
				type =  form
				form = Interventions
				record event = on add or edit
					status = inactive

				on user input of DAE_Num_ro_de_s_rie
				{
					actions 
					{
						custom deluge script
						(
											if(DAE[ID == input.DAE_Num_ro_de_s_rie].count() > 0)
										{
											temp = Interventions[ID == input.Client];
											input.Client = temp.Client;
										}
						)
					}
				}

			}
			Fetch_and_Auto_populate_C as "Fetch and Auto-populate Client"
			{
				type =  form
				form = Interventions
				record event = on add or edit

				on user input of DAE_Num_ro_de_s_rie
				{
					actions 
					{
						custom deluge script
						(
											DAERec = DAE[ID == input.DAE_Num_ro_de_s_rie];
										input.Client = DAERec.Client;
										input.Date_Insertion_lectrode = DAERec.Date_Insertion_lectrode;
										input.Date_Insertion_lectrode_Enfant = DAERec.Date_Insertion_lectrode_Enfant;
										input.Mail_grand_compte = DAERec.Email_grand_compte;
										input.Mail_France = DAERec.Email_France;
										input.N_S_rie = DAERec.DAE_Num_ro_de_s_rie;
										input.Mail_site = DAERec.Email_du_site1;
										input.Mail_secondaire = DAERec.Autre_Email_de_contact;
										input.Mail_Client = DAERec.Email_client_notifications;
										input.Email_du_site = DAERec.Email_du_site;
										input.Localisation_de_l_appareilDAE = DAERec.Localisation_de_l_appareilDAE;
										input.Emplacement_de_l_appareil_dans_le_bpatiment = DAERec.Emplacement_de_l_appareil_dans_le_bpatiment;
										input.Type_d_appareil = DAERec.Type_d_appareil;
										input.Mod_le_d_appareil = DAERec.Mod_le_d_appareil;
										input.Mod_le_bo_tier_mural = DAERec.Mod_le_bo_tier_mural;
										input.Date_de_fabrication = DAERec.Date_de_fabrication;
										input.Num_ro_de_lot = DAERec.Num_ro_de_lot;
										input.michoucodeyz = DAERec.michoucode;
										input.Fin_de_la_garantie_de_la_batterie = DAERec.Fin_de_la_garantie_de_la_batterie;
										input.Date_d_insertion_batterie = DAERec.Date_d_insertion_batterie;
										input.Num_ro_de_s_rie_AUIA = DAERec.Num_ro_de_s_rie_AUIA;
										input.Num_ro_de_lot_de_l_lectrode_1 = DAERec.Num_ro_de_lot_de_l_lectrode_1;
										input.Num_ro_de_lot_de_l_lectrode_2 = DAERec.Num_ro_de_lot_de_l_lectrode_2;
										input.Num_ro_de_lot_de_l_lectrode_3 = DAERec.Num_ro_de_lot_de_l_lectrode_3;
										input.Date_de_p_remption_de_l_lectrode_1 = DAERec.Date_de_p_remption_de_l_lectrode_1;
										input.Date_de_p_remption_de_l_lectrode_2 = DAERec.Date_de_p_remption_de_l_lectrode_2;
										input.Date_de_p_remption_de_l_lectrode_3 = DAERec.Date_de_p_remption_de_l_lectrode_3;
										input.Information_Adresse = DAERec.Information_Adresse;
										input.Date_MES = DAERec.Date_de_mise_en_service;
										input.Num_ro_de_lot_de_l_lectrode_p_diatrique = DAERec.Num_ro_de_lot_de_l_lectrode_p_diatrique;
										input.Date_de_p_remption_de_l_lectrode_p_diatrique = DAERec.Date_de_p_remption_de_l_lectrode_p_diatrique;
