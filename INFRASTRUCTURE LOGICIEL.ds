		form Organisateur_de_tourn_es_d_interventions
		{
			displayname = "Organisateur de tournées d'interventions"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Nommez_la_tourn_e
			(
    			type = text
				displayname = "Nommez la tournée"
	 			row = 1
	 			column = 1   
				width = medium
			)
			locationsinterv
			(
				type = list	
				displayname = "Créer une intervention"
