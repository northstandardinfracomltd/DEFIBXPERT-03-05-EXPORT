					alloweddays = 0,1,2,3,4,5,6
					width = medium
				)
				Date_P_remption_Batterie
				(
    				type = date
					displayname = "Date Péremption Batterie"
					alloweddays = 0,1,2,3,4,5,6
					width = medium
				)
				Date_P_remption_lectrode_Enfant
				(
    				type = date
					displayname = "Date Péremption Électrode Enfant"
					alloweddays = 0,1,2,3,4,5,6
					width = medium
				)
	 			row = 3
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
