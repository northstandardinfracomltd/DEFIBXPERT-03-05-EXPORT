			sort by
			(
				Modified_Time descending
			)
			custom actions
			(
				"Afficher les intervention(s)"
				(
	  			workflow = viewassocintervent
				show action in edit record menu = true
				)
				"Planifier une interv."
				(
	  			workflow = Prefillvisite
				show action in edit record menu = true
				condition = (DAE_Num_ro_de_s_rie is not null)
				confirmation before execution
				(
					message for individual record = "Souhaitez-vous créer une visite pour ce défibrillateur ?"
					confirm button text = "Oui"		
					cancel button text = "Non"
				)
				)
				"Contrat"
				(
	  			workflow = wherecontrat
				show action in edit record menu = true
				condition = (TypeReport.contains("Contrat"))
				)
				"Nouvelle Tournée"
				(
	  			workflow = tourneex
				show action in view header = true
				show action in edit record menu = true
				execute action for collection of records
				confirmation before execution
				(
					message for multiple records = "Les ${record_count} défibrillateurs seront ajoutés dans une nouvelle tournée."
					confirm button text = "Créer la Tournée"		
					cancel button text = "Retour"
				)
				)
				"Placer dans le Parc sans MAIN"
				(
	  			workflow = X10
				show action in view header = true
				show action in edit record menu = true
				confirmation before execution
				(
					message for multiple records = "Les ${record_count} défibrillateurs seront placés dans l'onglet 'Parc sans MAIN'"
					confirm button text = "Confirmer"		
					cancel button text = "Retour"
				)
				)
				"Intégrer à la Tournée Existante"
				(
	  			workflow = deziaduhzioufherzf
