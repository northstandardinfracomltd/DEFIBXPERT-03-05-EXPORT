				(
					width = 311px
				)
				Date_de_mise_en_service as "MES"
				Date_de_fabrication as "Fabrication"
				(
					width = 124px
				)
				Dur_e_de_garantie_de_l_appreil as "Durée de garantie du défibrillateur"
				Date_de_fin_de_garantie as "Garantie Fabricant"
				DAE_Num_ro_de_s_rie as "N° Série"
				(
					width = 166px
				)
				Type_d_appareil as "Type"
				Mod_le_d_appareil as "Modèle"
				(
					width = 170px
