			(
				Modified_Time descending
			)
			conditional formatting
			(
				"blue New Formatting"
				{
				fields = [Emailrs, T_l_phone]
				format = "color:#2f78d0;background-color:#e7f7fc;"
				}
				"New effe"
				{
				condition = (Expiration_renouvellement_du_contrat < zoho.currentdate)
				fields = [Expiration_renouvellement_du_contrat]
				format = "color:#ffffff;background-color:#ef1616;"
				}
				"deded"
				{
				condition = (Expiration_renouvellement_du_contrat in next 90 days)
				fields = [Expiration_renouvellement_du_contrat]
				format = "color:#ffffff;background-color:#ef8216;"
				}
				"New Formatting"
				{
				fields = [Sous_d_nomination, Adresse_pour_la_facturation]
				format = "color:#1378bd;background-color:#f2f2f2;"
				}
				"Tous (bleu)"
				{
				fields = [Client, P_le, Sous_d_nomination1, CP_Filtre]
				format = "color:#2d3b90;background-color:#f7f8ff;"
				}
			)
		}
