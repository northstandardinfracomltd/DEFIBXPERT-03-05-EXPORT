					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Commande_Stickers
		{
			title 
    		{
				displayname = "Panneaux Signalétiques DéfibXpert"
    			on add = "Panneaux Signalétiques DéfibXpert"
   	 			on edit = "Panneaux Signalétiques DéfibXpert"
			}
			success message = "Commande Placée à SaaSduo"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			plain
			(
    			type = plaintext
				value = "<div>\n <a href=\"https://saasduo.com/terms/\" target=\"_blank\" rel=\"noopener noreferrer\">SaaSduo Terms </a> &nbsp;— <a href=\"https://saasduo.com/privacy/\" target=\"_blank\" rel=\"noopener noreferrer\"> SaaSduo Privacy </a> &nbsp;— <a href=\"https://policies.google.com/terms\" target=\"_blank\" rel=\"noopener noreferrer\"> SaaS Conditions d'utilisation </a>\n <br>\n</div>\n<div>\n <br>\n</div>\n<div>\n <br>\n</div>\n<div>\n <ul>\n  <li>Longeur de 28cm (280mm).<br></li>\n  <li><span>Hauteur de 19cm (190mm).</span><br></li>\n  <li><span>Matière PVC Rigide Épaisseur 3mm.</span><br></li>\n  <li><span>Traitement Pelliculage (résistant UV et usure générale).</span><br></li>\n  <li><span>Dos avec 2 bandes autocollantes 3M largeur 19mm.</span><br></li>\n  <li><span>4 modèles de directions disponibles.</span><br></li>\n  <li><span>Minimum de commande de 5 unités.</span><br></li>\n  <li><span>Affichage et composition conforme signalétique réglementaire.</span><br></li>\n  <li><span>Livraison à partir de 7 jours en fonction de la quantité.</span><br></li>\n  <li><span>Prix TTC par panneau de&nbsp;50€. </span><br></li>\n  <li><span>10% dégressif à partir de 30 unités. </span><br></li>\n  <li><span>20% dégressif à partir de 100 unités.</span><br></li>\n  <li><span>Paiement comptant avant production requis.</span><br></li>\n </ul>\n <div>\n  <span class=\"colour\" style=\"color: rgb(0, 0, 0)\"></span><img height=\"542\" src=\"https://cdn.glitch.global/64d6502c-a435-4487-8300-10469d916788/PANNEAUDAECARDIACSAFE.png?v=1703167774761\" style=\"\" width=\"763\">\n  <br>\n </div>\n</div>\n<div>\n <br>\n</div>"
	 			row = 1
	 			column = 1   
				width = medium
			)
			S_lection_des_Quantit_s
			(
				type = section
				displayname = "Sélection des Quantités"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Quantit_pour_Fl_che_vers_le_bas
			(
				type = number
				displayname = "Quantité pour \"Flèche vers le bas\""
				maxchar = 3
				initial value = 0
    			description
    			[
    				type = help_text
    			 	message = "Prix TTC /Unité de 50€"
    			]
	 			row = 2
	 			column = 1   
				width = 35px
			)
			Quantit_pour_Fl_che_vers_le_haut
			(
				type = number
				displayname = "Quantité pour \"Flèche vers le haut\""
				maxchar = 3
				initial value = 0
    			description
    			[
    				type = help_text
    			 	message = "Prix TTC /Unité de 50€"
    			]
	 			row = 2
	 			column = 1   
