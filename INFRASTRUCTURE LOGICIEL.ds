			deziaduhzioufherzf as "deziaduhzioufherzf"
			{
				type =  functions
				form = DAE
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						fe = Tourn_e[ID == input.S_lection_de_la_tourn_e];
										r1 = Tourn_e.D_fibrillateur_s();
										r1.MiniRef=input.MiniCode1;
										r1.N_S_rie=input.DAE_Num_ro_de_s_rie;
										r1.Email_Client=input.Email_client_notifications;
										r1.Adresse_D_fibrillateur=input.Localisation_de_l_appareilDAE;
										r1.Emplacement=input.Emplacement_de_l_appareil_dans_le_bpatiment;
										r1.Client=input.Information_Adresse;
										r1.Date_P_remption_Batterie=input.michoucode;
										r1.Date_P_remption_lectrode=input.Date_de_p_remption_de_l_lectrode_1;
										r1.Date_P_remption_lectrode_Enfant=input.Date_de_p_remption_de_l_lectrode_p_diatrique;
										fe.D_fibrillateur_s.insert(r1);
					)
					}
					actions 
					{
					on click
					(
						input.Statut_Visite = "Ajouté à une Tournée";
										openUrl("#Report:Tourn_e_Report","same window");
					)
					}
				}
			}
