			delete_multiple_results_d as "delete multiple results drop"
			{
				type =  form
				form = DAE
				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											var = Clients[ID != 0].P_le.getAll().distinct();
										L = list();
										for each  x in var
										{
											L.add(Clients[P_le == x].ID);
										}
										input.Structures_associ_es:ui.add(L);
						)
					}
				}

			}
			Test_autofill1 as "Test autofill"
			{
				type =  form
				form = Cr_er_tourn_e
				record event = on add or edit
					status = inactive

				on user input of DAE_Num_ro_de_s_rie
				{
					actions 
					{
						custom deluge script
						(
											if(DAE[ID == input.DAE_Num_ro_de_s_rie].count() > 0)
										{
											temp = Interventions[ID == input.Client];
											input.Client = temp.Client;
										}
						)
					}
				}

			}
