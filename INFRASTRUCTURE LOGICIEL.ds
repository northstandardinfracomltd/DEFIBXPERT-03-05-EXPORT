				{
				condition = (Statut == "En retard" || Statut == "Attention requise" || Statut == "À planifier")
				format = "color:#ef1616;map-icon:weather-moon-full;map-icon-color:#ffffff;"
				}
				"Effectuée ou planifiée"
				{
				condition = (Statut == "Effectuée" || Statut == "Annulée")
				format = "color:#a811cc;map-icon:weather-moon-full;map-icon-color:#ffffff;"
				}
				"à faire"
				{
				condition = (Statut == "Planifiée")
				format = "color:#2f78d0;map-icon:weather-moon-full;map-icon-color:#ffffff;"
				}
				"New Formatting"
				{
				condition = (Statut == "En retard" || Statut == "Attention requise" || Statut == "À planifier")
				fields = [Client.Client]
				format = "color:#e64d3b;"
				}
				"New Formatting"
				{
				condition = (Statut == "Effectuée" || Statut == "Annulée")
				fields = [Client.Client]
				format = "color:#c516ef;"
				}
				"New Formatting"
				{
				condition = (Statut == "Planifiée")
				fields = [Client.Client]
				format = "color:#2f78d0;"
				}
			)
		}
