				fields = [Statutenvoi]
				format = "color:#ef8216;"
				}
				"New Formattingdzad"
				{
				condition = (Statutenvoi == "Envoyé")
				fields = [Statutenvoi]
				format = "color:#4ea64c;"
				}
				"New Formattingdede2929"
				{
				condition = (Statut_du_contrat == "Envoyé")
