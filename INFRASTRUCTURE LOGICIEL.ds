				(
					width = 136px
				)
				custom action "Contrat"
				(
	  			workflow = voircontrat
				show action in edit record menu = true
				column header = "Contrat"
				condition = (Contrat_hide.contains("Contrat"))
				)
				custom action "Rapport"
				(
	  			workflow = viewrapports
				show action in edit record menu = true
				column header = "Rapport"
				condition = ((G_n_ration == "Depuis l'édition d'un rapport" && !Contrat_hide.contains("Inconnu (pré.maj)")) || (G_n_ration == "Depuis la création d'une visite" && !Contrat_hide.contains("Inconnu (pré.maj)")))
				)
				Contrat_hide as "Type Contrat"
				(
					width = 142px
				)
				Date_Rapport as "Date Rapport"
				(
					width = 127px
				)
				LinkIntervenant as "Technicien"
				(
					width = 170px
				)
				Batterie_chang_e_2 as "Batterie changée ?"
				(
					width = 237px
				)
				lectrode_chang_e_2 as "Électrode changée ?"
				(
					width = 242px
				)
			)
			sort by
			(
				Added_Time descending
			)
			conditional formatting
			(
				"New Formatting"
				{
				fields = [Montant_HT, Num_ro_de_la_pi_ce_comptable, Type_de_pi_ce_comptable, Pi_ce_jointe, Commentaires_libres, G_n_ration, Client, Added_Time, Num_ro_de_s_rie_du_d_fibrillateur, Contrat_hide, Date_Rapport, LinkIntervenant, Batterie_chang_e_2, lectrode_chang_e_2]
				format = "color:#1378bd;background-color:#f2f2f2;"
				}
				"New Formatting"
				{
				condition = (Statut_de_facturation == "À facturer" || Statut_de_facturation == "En attente" || Statut_de_facturation == "Inconnu" || Statut_de_facturation is null)
				fields = [Statut_de_facturation]
				format = "color:#8b0808;background-color:#fce7e7;"
				}
				"New Formatting"
				{
				condition = (Statut_de_facturation == "Payée / Terminée" || Statut_de_facturation == "Pas de facturation requise")
				fields = [Statut_de_facturation]
				format = "color:#337131;background-color:#eaf5ea;"
				}
				"New Formatting"
				{
				condition = (Statut_de_facturation == "Facturé")
				fields = [Statut_de_facturation]
				format = "color:#cc9711;background-color:#fcf2e7;"
				}
			)
		}
