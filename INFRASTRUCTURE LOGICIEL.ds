		form supportasker
		{
			displayname = "Support SaaSduo"
			success message = "Envoyé à SaaSduo"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			plain
			(
    			type = plaintext
				value = "<div>\n <a href=\"https://saasduo.com/terms/\" target=\"_blank\" rel=\"noopener noreferrer\">SaaSduo Terms</a>&nbsp;— <a href=\"https://saasduo.com/privacy/\" target=\"_blank\" rel=\"noopener noreferrer\">SaaSduo Privacy</a>&nbsp;— <a href=\"https://policies.google.com/terms\" target=\"_blank\" rel=\"noopener noreferrer\">SaaS Conditions d'utilisation</a>\n <br>\n</div>"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Type_de_demande
			(
				type = picklist
				displayname = "Type Demande"
				maxchar = 100
				values = {"Aide, question, formation, (...)","Modification, changement, (...)","Signaler un problème","Autre demande"}
	 			row = 1
	 			column = 1   
				width = 500px
			)
			must have R_daction_de_ma_demande
			(
    			type = textarea
				displayname = "Rédaction Demande"
				height = 100px
	 			row = 1
	 			column = 1   
				width = 500px
			)
			must have Email
			(
    			type = email
				initial value = "defibrillateur@cardiacsafe.fr"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = 500px
				personal data = true
			)
			emailcopy
			(
    			type = email
				displayname = "Mettre en Copie"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = 500px
				personal data = true
			)
			Num_ro_WhatsApp
			(
    			type = text
				displayname = "Numéro (WhatsApp)"
				initial value = "+33 7 63 85 83 11"
	 			row = 1
	 			column = 1   
				width = 500px
			)
	
			actions
			{
				on add
				{
					Envoyer___SaaSduo
					(
   						type = submit
   						displayname = "Envoyer à SaaSduo"
					)
				}
				on edit
				{
					Modifier
					(
   						type = submit
   						displayname = "Modifier"
					)
				}
			}
		}
		form Support_Signalement
		{
			displayname = "Support Signalement"
			success message = "Data Added Successfully!"
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Templates_envois_message
		{
			displayname = "Templates messagerie"
			success message = "Enregistré"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Sujet
			(
    			type = text
				displayname = "Sujet du type d'envoi"
    			description
    			[
    				type = tooltip
    			 	message = "Précisez le sujet"
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Message_au_client
			(
    			type = textarea
				displayname = "Texte formaté"
				height = 480px
    			description
    			[
    				type = tooltip
    			 	message = "Template du message textuel"
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Enregistrer
					(
   						type = submit
   						displayname = "Enregistrer"
					)
				}
				on edit
				{
					Mettre___jour
					(
   						type = submit
   						displayname = "Mettre à jour"
					)
					Annuler
					(
   						type = cancel
   						displayname = "Annuler"
					)
				}
			}
		}
		form TESt1
		{
			title 
    		{
    			on add = "Création intervention sur un DAE"
   	 			on edit = "Modification intervention sur un DAE"
			}
			success message = "Enregistré"
			Prise_en_charge
			(
				type = section
				displayname = "Prise en charge"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			plain
			(
    			type = plaintext
				value = "<div class=\"align-center\" style=\"text-align: center\"><img width=\"300px\" src=\"https://cdn.glitch.global/b99994f5-4c44-4691-9f5c-108578f7e2e0/SP.png?v=1678964682686\">&nbsp;<br /></div>"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Intervenant_s
			(
				type = list	
				displayname = "Intervenant(s) sur la visite"
				values  = Intervenants.ID
    			displayformat = [Nomooo92]
				sortorder = ascending
				height = 60px
    			description
    			[
    				type = tooltip
    			 	message = "Qui est en charge de l'intervention"
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Date_de_derni_re_maintenance
			(
    			type = date
				displayname = "Date début visite"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
    			description
    			[
    				type = tooltip
    			 	message = "Quand a lieu l'intervention ?"
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Heure_de_l_intervention
			(
    			type = time
				displayname = "Horaire début visite"
				initial value = "${zoho.currenttime}"	
				timedisplayoptions = "hh:mm" 
    			description
    			[
    				type = tooltip
    			 	message = "Quelle est l'heure d'intervention ?"
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
			IDintervention
			(
    			type = autonumber
				displayname = "Référence d'intervention"
				start index = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			Communication_automatique
			(
				type = section
				displayname = "Communication du rapport pdf"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Emailrs
			(
    			type = email
				displayname = "Email client"
				maxchar = 80
    			description
    			[
    				type = help_text
    			 	message = "Utilisé pour envoyer un rapport PDF"
    			]
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			Autre_email_si_n_cessaire
			(
    			type = email
				displayname = "Autre email si nécessaire (Intervenant)"
				maxchar = 80
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			Identification_du_DAE_contr_l_ou_en_intervention
			(
				type = section
				displayname = "Identification de l'appareil"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			DAE_Num_ro_de_s_rie
			(
				type = picklist	
				displayname = "N° de série"
				values  = DAE.ID
    			displayformat = [DAE_Num_ro_de_s_rie]
				sortorder = ascending
    			description
    			[
    				type = tooltip
    			 	message = "Rennseignez le numéro de série communiqué par SP ENSEIGNEMENT. Les données connues seront ainsi immédiatement remplies."
    			]
	 			row = 3
	 			column = 1   
				width = medium
			)
			must have Client
			(
				type = picklist	
				values  = Clients.ID
    			displayformat = [Client]
				sortorder = ascending
	 			row = 3
	 			column = 1   
				width = medium
			)
			must have Localisation_de_l_appareilDAE
			(
    			type = address
				displayname = "Localisation de l'appareil"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "N° et rue"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
