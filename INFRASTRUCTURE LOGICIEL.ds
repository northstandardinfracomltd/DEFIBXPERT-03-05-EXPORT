		form Archives_inventaire
		{
			displayname = "Archives inventaire"
			store data in zc = false
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Fournisseurs
			(
				type = picklist	
				values  = Fournisseurs.ID
    			displayformat = [Nom_du_fournisseur]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			D_nomination_normalis_e
			(
				type = picklist
				displayname = "Choisir une dénomination standard"
				maxchar = 100
				values = {"Défibrillateur Cardiac Science G3","Défibrillateur Cardiac Science G5","Défibrillateur Samaritan PAD 360 P","Défibrillateur Samaritan PAD 500 P","Défibrillateur ZOLL AED 3","Défibrillateur ZOLL AED Plus","Défibrillateur Mindray C1","Défibrillateur Mindray C2","Défibrillateur IPAD 1200","Boîtier AIVIA SOLO","Boîtier 200","Boîtier 200 W","Boîtier 100","Boîtier 100 W","Boîtier Métallique Blanc","Boîtier Métallique Vert","Boîtier Support Simple","Boîtier Sacoche","Boîtier Rotaid Extérieur","Signalétique DAE Externe Flèche à droite","Signalétique DAE Externe Flèche à gauche","Signalétique DAE Externe Flèche vers le bas","Signalétique DAE Ce site est équipe d’un défibrillateur cardiaque","Signalétique DAE Vitrophanie Ce site est équipe d’un défibrillateur cardiaque","Signalétique Pictogrammes en drapeau et tridimensionnels ISO 7010","Signalétique Panneaux et autocollants NF EN ISO 7010 DAE","Signalétique Panneaux en drapeau et tridimensionnels ISO 7010 DAE","Signalétique DAE Vertical basique","PadPak adulte Samaritan PAD","Paire d’électrodes pédiatriques pour défibrillateur Philips Heartstart HS1","PadPak enfant Samaritan PAD","Électrodes enfants Schiller Easyport PA-1 (paire)","Paire électrodes adultes Philips Heartstart HS1","Électrodes adultes I-PAD (paire)","Paire électrodes HS Smart II Philips FRx","Électrodes adultes Schiller Fred PA-1 Easyport (paire)","Porte-affiche pour cadre d’affichage","Batterie Mindray C-Serie","Rescue Sam Batterie","Physio-Control Lifepak CR2","Defibtech Lifeline Batterie 5 ans","DefiSign Life Batterie","Nihon Kohden Batterie AED-3100","Nihon Kohden Batterie AE-2100","ZOLL AED 3 Batterie","Philips Heartstart Batterie HS1 FRx","Life-Point Batterie","CU Medical Batterie IPAD NF 1200","CU Medical Batterie IPAD SP1","Philips FR3 Batterie","Cardiac Science Batterie Powerheart G5","Batterie Mindray D1","Heartsine Samaritan PediPak Pediatrique","Physio Control LIFEPAK CR Plus Pile 2 Paires","M&B AED 7000 Batterie","Schiller Fred Easyport Batterie","ZOLL AED PRO Batterie","ZOLL AED PLUS Batteries / Piles","SCHILLER Fred Easy / Skity Batterie","Primedic HeartSave PAD Batterie (3 ans)","Primedic HeartSave AED Batterie (6 ans)","Physio Control Batterie LifePak 1000","Physio Control LIFEPAK CR PLUS Pile + 1 paire électrodes","Philips Heartstart FR2 Batterie","Cardiac Science Batterie Powerheart G3 Pro","Cardiac Science Batterie Powerheart G3 / G3 Plus","Heartsine Samaritan Pad-Pak Adulte","Defibtech Lifeline","Defibtech Lifeline 7 ans"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have titreproduit
			(
    			type = text
				displayname = "Dénomination personnalisée"
    			description
    			[
    				type = tooltip
    			 	message = "Précisez le titre du produit"
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
			DAE_Num_ro_de_s_rie
			(
    			type = text
				displayname = "Numéro de série"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have product_type
			(
				type = picklist
				displayname = "Type"
				maxchar = 100
				values = {"Défibrillateur","Électrode","Batterie","Coffre/Boîtier","Signalétique","Accessoire","Autre"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Tarif_TTC_unitaire
			(
				type = decimal
				displayname = "Tarif HT"
    			description
    			[
    				type = tooltip
    			 	message = "Précisez le tarif TTC pour 1 produit"
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Quantit_en_stock1
			(
				type = number
				displayname = "Quantité en stock"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Valeur_HT_fiche
			(
				type = decimal
				displayname = "Valeur HT fiche"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have R_f_rence_du_bon_de_livraison
			(
    			type = text
				displayname = "Référence du bon de livraison"
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Date_de_livraison
			(
    			type = date
				displayname = "Date de livraison chez SP"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have in_stock
			(
    			type = date
				displayname = "Entrée en stock"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			Date_p_remption
			(
    			type = date
				displayname = "Date péremption"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			out_stock
			(
    			type = date
				displayname = "Sortie de stock"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			O_est_stock_le_produit
			(
    			type = textarea
				displayname = "Où est stocké le produit ?"
				height = 100px
	 			row = 1
	 			column = 2   
				width = medium
			)
			Section2
			(
				type = section
				displayname = " "
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Quantit_en_stock
			(
				type = number
				displayname = "Unité (stock)"
				initial value = 1
				private = true
	 			row = 2
	 			column = 1   
				width = medium
			)
			Statut
			(
				type = picklist
				maxchar = 100
				values = {"En stock","Épuisé"}
				initial value = "En stock"
    			description
    			[
    				type = none
    			 	message = "Quel est le statut des stocks ?"
    			]
				private = true
	 			row = 2
	 			column = 1   
				width = medium
			)
			Description_du_produit
			(
    			type = textarea
				displayname = "Description du produit"
				height = 100px
    			description
    			[
    				type = none
    			 	message = "Ajoutez des détails sur le produit"
    			]
				private = true
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				Submit
				(
   					type = submit
   					displayname = "Submit"
				)
				Reset
				(
   					type = reset
   					displayname = "Reset"
				)
			}
		}
		form Avis_de_passage
		{
			title 
    		{
				displayname = "Avis de passage"
    			on add = "Nouveau avis de passage"
   	 			on edit = "Modification avis de passage"
			}
			success message = "Enregistré"
			Intervention_sur_un_appareil
			(
				type = grid
				displayname = "Référence(s) intervention(s)"
				must have R_f_rence_de_l_intervention
				(
					type = picklist	
					displayname = "Référence(s) intervention(s)"
					values  = Interventions.ID
    				displayformat = ["Référence " + IDintervention]
					sortorder = ascending
    				description
    				[
    					type = tooltip
    				 	message = "Précisez le/s référence/s d'intervention/s effectuée/s"
    				]
					width = medium
				)
	 			row = 1
	 			column = 1   
				width = medium
			)
			Section
			(
				type = section
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Nombre_d_appareils_contr_l_s
			(
				type = number
				displayname = "Nombre d'appareils contrôlés lors du passage"
    			description
    			[
    				type = tooltip
    			 	message = "Lors du passage chez le client, combien de défibrillateurs avez-vous contrôlé ?"
    			]
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Date_d_mission_de_l_avis_de_passage
			(
    			type = date
				displayname = "Date d’émission de l'avis de passage"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
    			description
    			[
    				type = tooltip
    			 	message = "Précisez et vérifiez la date du jour"
    			]
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Client
			(
				type = picklist	
				values  = Clients.ID
    			displayformat = [Client]
				sortorder = ascending
    			description
    			[
    				type = tooltip
    			 	message = "Chez quel client avez-vous effectué l'intervention ?"
    			]
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Personne_pr_sente_chez_le_client
			(
    			type = text
				displayname = "Personne présente chez le client"
    			description
    			[
    				type = tooltip
    			 	message = "Qui était présent lors du compte rendu de l'intervention chez le client ?"
    			]
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Signature_r_f_rant_client
			(
    			type = signature
				displayname = "Signature référant client"
    			description
    			[
    				type = tooltip
    			 	message = "Demandez à la personne présente chez le client d'apposer une signature"
    			]
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Intervenant_s_pr_sent_s
			(
				type = list	
				displayname = "Intervenant(s) présent(s)"
				values  = Intervenants.ID
    			displayformat = [Nomooo92]
				sortorder = ascending
				height = 60px
    			description
    			[
    				type = tooltip
    			 	message = "Qui a pris en charge l'intervention ?"
    			]
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Signature_de_l_intervenant
			(
    			type = signature
				displayname = "Signature de l'intervenant "
    			description
    			[
    				type = tooltip
    			 	message = "1 intervenant doit signer le compte rendu"
    			]
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
	
			actions
			{
				on add
				{
					Enregistrer1
					(
   						type = submit
   						displayname = "Enregistrer"
					)
				}
				on edit
				{
					Enregistrer
					(
   						type = submit
   						displayname = "Enregistrer"
					)
					Annuler_les_modifications
					(
   						type = cancel
   						displayname = "Annuler les modifications"
					)
				}
			}
		print template
			{
				R_c_piss_avis_de_passage
