				 void Zohotestfunction()
                 {
                 	rec = DAE[ID == 151691000002045211];
                 	if(rec.Date_de_p_remption_de_l_lectrode_1 < zoho.currentdate)
                 	{
                 		info "1";
                 	}
                 	if(rec.michoucode < zoho.currentdate)
                 	{
                 		info "2";
                 	}
                 	if(rec.Date_de_p_remption_de_l_lectrode_p_diatrique < zoho.currentdate)
                 	{
                 		info "3";
                 	}
                 }
			 }
