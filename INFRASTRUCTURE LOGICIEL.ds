	  			workflow = Cl_turer_le_d_ploiement
				show action in edit record menu = true
				column header = "Clôturer le Déploiement"
				condition = (Statut_d_ploiement == "En déploiement" || Statut_d_ploiement == "Ajouté à la base des actifs" || Statut_d_ploiement == "Nouveau")
				confirmation before execution
				(
					message for individual record = "Souhaitez-vous terminer définitivement l'édition de l'intégration du défibrillateur ? Attention, cette action est définitive."
					confirm button text = "Clôturer définitivement"		
					cancel button text = "Annuler pour l'instant"
				)
				)
				Emailrs as "Email client sur site"
				Notes_internes as "Notes internes libres"
				N_de_lot_de_la_batterie as "N° de lot de la batterie"
				N_de_lot_de_l_lectrode as "N° de lot de l'électrode"
				Date_de_p_remption_de_la_batterie as "Date de péremption de la batterie"
				Date_de_p_remption_de_l_lectrode as "Date de péremption de l'électrode"
				Montant_HT_facturer as "Montant HT à facturer"
				Statut_de_facturation as "Statut de facturation"
				Devis_sign_ou_facture as "Devis signé,facture ou bon de commande (Numéro)"
			)
			conditional formatting
			(
				"New Formattingeded"
				{
				condition = (Statut_d_ploiement == "Ajouté à la base des actifs")
				fields = [Statut_d_ploiement]
				format = "color:#4ea64c;background-color:#f2f2f2;"
				}
				"New Formattingded"
				{
				condition = (Statut_d_ploiement == "Clôturé")
				fields = [Statut_d_ploiement]
				format = "color:#1378bd;background-color:#f2f2f2;"
				}
				"New Formattingded"
				{
				condition = (Statut_d_ploiement == "En déploiement")
				fields = [Statut_d_ploiement]
				format = "color:#cc9711;background-color:#f2f2f2;"
				}
				"dededed"
				{
				condition = (Statut_d_ploiement == "Nouveau")
				fields = [Statut_d_ploiement]
				format = "color:#cc9711;background-color:#f2f2f2;"
				}
				"New Formatting"
				{
				fields = [DAE_Num_ro_de_s_rie]
				format = "color:#1378bd;background-color:#f2f2f2;"
				}
				"New Formatting ALL"
				{
				fields = [titreproduit, Added_Time, Localisation_de_l_appareilDAE]
				format = "color:#1378bd;background-color:#f2f2f2;"
				}
			)
		}
