		form Bo_te_id_es_logiciel
		{
			title 
    		{
				displayname = "Boîte à idées logiciel"
    			on add = "Ajout"
   	 			on edit = "Modification"
			}
			success message = "Ajoutée à la boîte à idées !"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Titre_de_l_id_e
			(
    			type = text
				displayname = "Titre de l'idée"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Description_de_l_id_e
			(
    			type = textarea
				displayname = "Description de l'idée"
				height = 300px
	 			row = 1
	 			column = 1   
				width = large
			)
			Propos_par
			(
				type = picklist
				displayname = "Proposé par"
				maxchar = 100
				values = {"Yann Gillard","Barbara Crelo","Ronan Roesch"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Image_optionnel
			(
    			type = image
				displayname = "Image (optionnel)"
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Fichier_optionnel
			(
    			type = upload file
				displayname = "Fichier (optionnel)"
				browse = local_drive
	 			row = 1
	 			column = 1   
				width = medium
			)
			Commentaire_s
			(
				type = grid
				displayname = "Commentaire(s)"
				Titre_du_commentaire
				(
    				type = text
					displayname = "Titre du commentaire"
					private = true
					width = medium
				)
				Commentaire
				(
    				type = textarea
					height = 100px
					private = true
					width = medium
				)
				D_pos_par
				(
					type = picklist
					displayname = "Déposé par"
					maxchar = 100
					values = {"Yann Gillard","Barbara Crelo","Ludovic Desvaux","Ronan Roesch"}
					others option = true
					private = true
					width = medium
				)
				private = true
	 			row = 2
	 			column = 1   
				width = medium
			)
			Section1
			(
				type = section
				displayname = "Section"
	 			row = 3
	 			column = 0   
				width = medium
			)
			Statut
			(
				type = picklist
				maxchar = 100
				values = {"Nouveau","Brouillon","Refusé (incohérence ou incompatible)","Validé","Terminé","En publication","Épinglé par SaaSduo"}
				initial value = "Nouveau"
				private = true
	 			row = 3
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Transmettre
					(
   						type = submit
   						displayname = "Transmettre"
					)
					Annuler
					(
   						type = reset
   						displayname = "Annuler"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Mettre à jour"
					)
					cancel
					(
   						type = cancel
   						displayname = "Annuler"
					)
				}
			}
		}
		form Communication_client
		{
			displayname = "Communication au client"
			captcha = true
			success message = "Tâche effectuée"
			Communication_au_client
			(
				type = section
				displayname = "Communication au client"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have S_lectionner_un_client
			(
				type = picklist	
				displayname = "Sélectionner un client"
				values  = Clients.ID
    			displayformat = [Client]
				sortorder = ascending
    			description
    			[
    				type = tooltip
    			 	message = "Utilisé afin de retrouver les informations de contact du client"
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have T_l_phone
			(
    			type = phonenumber
				displayname = "N° Tel"
    			description
    			[
    				type = tooltip
    			 	message = "Numéro de téléphone enregistré pour ce client"
    			]
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Email
			(
    			type = email
				maxchar = 80
    			description
    			[
    				type = tooltip
    			 	message = "Adresse email enregistrée pour ce client"
    			]
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Message_envoy_par
			(
				type = picklist
				displayname = "Message envoyé par"
				maxchar = 100
				values = {"Yann Gillard","Barbara Crelo","Mathieu Crelo","Fabrice Seon","Cédric Vally","Éric Justice","Kévin Soudry"}
				others option = true
    			description
    			[
    				type = tooltip
    			 	message = "Par qui est envoyé le message"
    			]
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Type_de_communication
			(
				type = picklist
				displayname = "Type de communication"
				maxchar = 100
				values = {"Notification de RDV","Communication classique","Information péremption","Information garantie"}
    			description
    			[
    				type = tooltip
    			 	message = "Utilisé comme objet de message"
    			]
	 			row = 1
	 			column = 2   
				width = medium
			)
			Sujet
			(
				type = picklist	
				displayname = "Templates messagerie"
				values  = Templates_envois_message.ID
    			displayformat = [Sujet]
				sortorder = ascending
    			description
    			[
    				type = tooltip
    			 	message = "Vous pouvez utiliser un template déjà existant, il ne vous reste qu'à modifier les informations souhaitées"
    			]
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Message_au_client
			(
    			type = textarea
				displayname = "Message au client"
				height = 400px
    			description
    			[
    				type = tooltip
    			 	message = "Rédigez votre message ici"
    			]
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					Envoyer_l_email
					(
   						type = submit
   						displayname = "Envoyer l'email"
					)
					Annuler1
					(
   						type = reset
   						displayname = "Annuler"
					)
				}
				on edit
				{
					Mettre___jour
					(
   						type = submit
   						displayname = "Mettre à jour"
					)
					Annuler
					(
   						type = cancel
   						displayname = "Annuler"
					)
				}
			}
		print template
			{
				Attestation_d_envoi_message
				{
							displayname = "Attestation d'envoi message"
							content = {"pageNumberOption":null,"orientation":"null","images":[{"fileName":"1662114607230_saoecomtemp.png","imageId":"img_40547887999999523","imageType":"upload","fileId":"2940678000000002091"},{"fileName":"","imageId":"","imageType":"","fileId":""},{"fileName":"1661121863374_LOGO-CLEAR.png","imageId":"img_39631317000000477","imageType":"upload","fileId":"2940678000000002014"}],"isFooterEnabled":false,"containerStyle":"","templateStyle":"text-align: left; width: 793.7px; margin: 0px auto; padding: 30px","version":"2","layout":"1","mainLayout":[{"elements":[{"type":"columns","element":{"split":"100","id":"u_elem_41349257000000477","elemStyle":"","collayouts":[{"colElements":[{"type":"spacer","element":{"id":"u_elem_41349242000000477","height":"25"}}]}]}},{"type":"columns","element":{"split":"100","id":"u_elem_39563785999999046","elemStyle":"","collayouts":[{"colElements":[{"type":"text","element":{"id":"u_elem_39563785999999046","fields":[],"content":"<div style=\"\">\n   <p style=\"text-align: center\"><font size=\"3\">Récépissé de communication externe&nbsp;<b>SPILOT<\/b>&nbsp;<\/font><\/p>\n  <\/div>"}},{"type":"spacer","element":{"id":"u_elem_41326525","height":"25"}},{"id":"u_elem_4017362","type":"fields","element":{"valueStyle":"width: 50%","valueTextStyle":"","fieldLayoutType":"2","labelText":"Message envoyé le","wrapperStyle":"","labelStyle":"width: 50%","Label_Name":"Added_Time","labelTextStyle":""}},{"id":"u_elem_4153429899999857","type":"fields","element":{"Lookup_Label_Name":"S_lectionner_un_client","valueStyle":"width: 50%","valueTextStyle":"","fieldLayoutType":"2","labelText":"Envoyé à","wrapperStyle":"","labelStyle":"width: 50%","Label_Name":"Client","labelTextStyle":""}},{"id":"u_elem_4014809899999857","type":"fields","element":{"valueStyle":"width: 50%","valueTextStyle":"","fieldLayoutType":"2","labelText":"Type de communication","wrapperStyle":"","labelStyle":"width: 50%","Label_Name":"Type_de_communication","labelTextStyle":""}},{"type":"