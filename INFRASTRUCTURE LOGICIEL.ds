		list Sous_traitances
		{
			displayName = "Sous-traitances"
			print template = Attestation_DAE
			show all rows from DAE  [Sous_traitance == "Oui"]  
			(
				Client
				(
					width = 321px
				)
				Coordonn_es_additionnelles as "Coordonnées additionnelles"
