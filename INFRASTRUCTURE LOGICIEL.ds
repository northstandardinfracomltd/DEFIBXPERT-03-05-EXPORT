		form messagesuitesupportauclient
		{
			displayname = "Envoyer un message"
			captcha = true
			success message = "Message envoyé !"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Destinataire_de_l_email
			(
    			type = email
				displayname = "Destinataire de l'email"
				maxchar = 80
    			description
    			[
    				type = help_text
    			 	message = "Vous recevrez une copie de ce message à : defibrillateurs@spenseignement.eu"
    			]
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Objet
			(
    			type = text
				displayname = "Objet du message"
	 			row = 1
	 			column = 1   
				width = medium
			)
			crivez_un_message
			(
    			type = textarea
				displayname = "Écrivez un message"
				height = 300px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Envoyer_maintenant
					(
   						type = submit
   						displayname = "Envoyer maintenant"
					)
					Annuler
					(
   						type = reset
   						displayname = "Annuler"
					)
				}
				on edit
				{
					Corriger
					(
   						type = submit
   						displayname = "Corriger"
					)
				}
			}
		}
		form Espaces_grands_comptes
		{
			displayname = "Espaces grands-comptes"
			captcha = true
			success message = "Demande en traitement"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Cr_er_un_espace_grand_compte_d_di_pour_le_client
			(
				type = picklist	
				displayname = "Créer un espace grand-compte dédié pour le client"
				values  = Clients.ID
    			displayformat = [Client]
				sortorder = ascending
    			description
    			[
    				type = tooltip
    			 	message = "Sélectionnez le client"
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Identifiant_de_connexion
			(
    			type = text
				displayname = "Identifiant de connexion"
    			description
    			[
    				type = tooltip
    			 	message = "Utilisé pour la connexion par le client sur une page dédiée"
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Mot_de_passe_de_connexion
			(
    			type = text
				displayname = "Mot de passe de connexion"
    			description
    			[
    				type = tooltip
    			 	message = "Utilisé pour la connexion par le client sur une page dédiée"
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Notes_internes
			(
    			type = textarea
				displayname = "Notes internes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Ajouter_un_logo
			(
    			type = upload file
				displayname = "Ajouter un logo"
				browse = local_drive
    			description
    			[
    				type = tooltip
    			 	message = "Personnalisez l'interface client en utilisant un logo"
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
			S
			(
    			type = text
				displayname = "Situation"
				initial value = "En cours de création"
				private = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Url_de_connexion
			(
    			type = text
				displayname = "Url de connexion"
				private = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Cr_er_un_espace_d_di
					(
   						type = submit
   						displayname = "Créer un espace dédié"
					)
					Annuler
					(
   						type = reset
   						displayname = "Annuler"
					)
				}
				on edit
				{
					Mettre___jour
					(
   						type = submit
   						displayname = "Mettre à jour"
					)
					Annuler1
					(
   						type = cancel
   						displayname = "Annuler"
					)
				}
			}
		}
		form Facturation
		{
			captcha = true
			success message = "Enregistré"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Client_en_facturation
			(
				type = picklist	
				displayname = "Client en facturation"
				values  = Clients.ID
    			displayformat = [Client]
				sortorder = ascending
    			description
    			[
    				type = tooltip
    			 	message = "Quel client doit-être facturé ?"
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Produit_en_facturation
			(
				type = picklist	
				displayname = "Produit en facturation"
				values  = Inventaire.ID
    			displayformat = [titreproduit]
				sortorder = ascending
    			description
    			[
    				type = tooltip
    			 	message = "Quel produit doit-être facturé au client ?"
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Quantit_utilis_e
			(
				type = number
				displayname = "Quantité en facturation"
    			description
    			[
    				type = tooltip
    			 	message = "Quelle quantité doit-être facturée au client pour ce produit ?"
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Statut_de_la_facturation
			(
				type = picklist
				displayname = "Statut de la facturation"
				maxchar = 100
				values = {"À facturer","Facture envoyée","Facture payée","Traité par le service comptable (terminé)","En attente ou à définir"}
    			description
    			[
    				type = tooltip
    			 	message = "Précisez le statut de la facturation, où en est-on ?"
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
			R_f_rence_pi_ce_comptable
			(
    			type = text
				displayname = "Référence pièce comptable"
				initial value = "À définir"
    			description
    			[
    				type = tooltip
    			 	message = "Précisez la référence de la pièce comptable, par exemple le numéro de la facture."
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Enregistrer
					(
   						type = submit
   						displayname = "Enregistrer"
					)
				}
				on edit
				{
					Mettre___jour
					(
   						type = submit
   						displayname = "Mettre à jour"
					)
					Annuler_les_modifications
					(
   						type = cancel
   						displayname = "Annuler les modifications"
					)
				}
			}
