			mbappe as "mbappe"
			{
				type =  form
				form = Planificateur
				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											fet = DAE[ID == input.DAE_Num_ro_de_s_rie];
										sendmail
										[
											from :"defibxpert@cardiacsafe.fr"
											to :input.Emailrequerant
											cc:"defibxpert@cardiacsafe.fr"
											reply to :"defibxpert@cardiacsafe.fr"
											subject :"Notification DéfibXpert — Intervention Défibrillateur"
											message :("Information : Il s'agit d'un email automatique.<br><br> Une intervention sur le défibrillateur ayant pour numéro de série " + input.doublecheckauth + " (annotations : " + input.Pr_cisions_l_op_rateur_territorial + ") est planifiée le " + input.Quand_l_op_rateur_doit_passer + " à l'adresse : " + input.Localisation_de_la_visite) + input.Information_Adresse + "<br><br>Lien d'accès pour compléter le rapport<div><a href='https://creatorapp.zohopublic.eu/saasduo-saas-platform/defibxpert/form-perma/Interventions/T3O2H46VxyvHMywZKJFbGkdnP0hekK4YuOyGk47yF7A6bvM6yf6arByx9PaYWQ6ntzK5jDSmUxkBEpTawsg5d14h77DCnvEjO7sk?DAE_Num_ro_de_s_rieccc=" + fet.DAE_Num_ro_de_s_rie + "'>Procéder au rapport</a></div><br><br>L'équipe Cardiac Safe"
										]
						)
					}
				}

			}
			contractbang as "contractbang"
			{
				type =  form
				form = contract
				record event = on add or edit

				on user input of contract_choice
				{
					actions 
					{
						custom deluge script
						(
											if(contract_choice == "Contrat tout compris")
										{
											input.Rich_Text = "<p> Il a été convenu ce qui suit : <br><br> <b>ARTICLE 1 : PRESTATIONS PROPOSÉES :</b> <br><br> a. <b>CARDIAC SAFE</b> assurera la maintenance préventive et curative annuelle, dans le cadre de la matériovigilance concernant les matériels de Type classe 2B, et classe 3 conformément aux recommandations du constructeur ainsi que de l’Agence Nationale de Sécurité du Médicament et des produits de santé (ANSM) et procèdera au changement de consommables électrodes et batterie, à leur date de péremption.<br> b. <b>CARDIAC SAFE</b> assurera également l’intervention d’un technicien en cas d’utilisation du défibrillateur sur une personne victime d’un arrêt cardiaque ou d’une mise en défaut signalé sur l’appareil afin de remettre en état le défibrillateur (Maintenance curative).<br> c. Le coût annuel correspond au passage chaque année du technicien ainsi que le coût des consommables, électrodes et batterie, à chaque fois que cela est nécessaire lissé sur 8 années, la durée de garantie du défibrillateur. Vous maîtriser ainsi le coût d’entretien de l’appareil sans surprise.<br> d. En cas de problème sur un défibrillateur durant sa période de garantie, ce dernier sera remplacé par un appareil neuf, si l’intervention d’un technicien ne permet pas de régler la panne par des opérations de maintenance classiques. Au-delà de la garantie de 8 ans, toutes interventions se feront sur devis <br><br> <b>ARTICLE 2 : CONDITIONS DE RÉALISATION.</b> <br><br> <b>CARDIAC SAFE,</b> vous proposera le passage d’un technicien habilité après prise de rendez-vous, chaque année dans le mois anniversaire de l’installation du défibrillateur <b>ou en rapport</b> avec la date de changement des consommables afin de pouvoir effectuer ces opérations en un seul passage. <br><br> À l’issue de l’opération de maintenance préventive et/ou curative effectuée conformément aux prescriptions définies dans le présent contrat, le registre de maintenance des défibrillateurs <b>Conforme au décret n° 2007-705 du 4 mai 2007</b> sera renseigné, cela faisant office de rapport d’intervention. <br><br> <b>CARDIAC SAFE</b> assurera la mise à jour de la base <b>GEO DAE conformément à l'arrêté du 29 octobre 2019</b> <br><br> Le remplacement des consommables sera effectué par le technicien le jour de son passage si cela est nécessaire, électrodes et batterie sans coût supplémentaire. <br><br> Les opérations de la maintenance préventive garantissent le bon fonctionnement du défibrillateur conformément aux recommandations du constructeur ainsi que de l’Agence Nationale de Sécurité du Médicament et des produits de santé (ANSM). <br><br> Elles consistent à : <br><br> 1. Contrôler le bon état général du défibrillateur. <br> 2. Vérifier les dates de péremption (électrodes et batterie).<br> 3. Contrôler la puissance restante de la batterie jusqu’à la prochaine visite.<br> 4. Vérifier les invites vocales conformément aux données du constructeur et des recommandations internationales.<br> 5. Faire choquer le défibrillateur, en cas de besoin, au moyen simulateur et d’un joule-mètre afin de vérifier si le condensateur délivre un choc conformément aux données du constructeur.<br> 6. Importer et analyser les données internes du défibrillateur grâce à un logiciel afin d’établir un rapport détaillé remis au commanditaire.<br> 7. Nettoyer le défibrillateur et son support le cas échéant avec produit neutre et chiffon doux.<br> 8. Apporter les conseils éclairés sur l’emplacement du ou des défibrillateurs.<br> 9. Mettre à jour le défibrillateur en cas d’évolution des recommandations internationales.<br> 10. Enregistrer le défibrillateur dans la base de données nationale <b>GEO DAE conformément à l'arrêté du 29 octobre 2019.</b><br> <br><br> <b>ARTICLE 3 : DUREE DU CONTRAT.</b> <br><br> Le présent contrat est conclu pour une durée de <b>1 an</b> et entrera en vigueur à partir de la date de la signature du contrat de maintenance du défibrillateur. Il donnera lieu à une facturation annuelle et sera renouvelable par tacite reconduction (pour la durée indiquée ci-dessus), sauf si l’une des parties adressée par écrit, au moins un mois avant l’expiration de la période des 48 mois, une notification de non-renouvellement à l’autre partie. <br><br> <b>ARTICLE 4 : CONTACTS.</b> <br><br> - Commandes accessoires, demandes d’intervention : 07 63 85 83 11 <br>- Contact urgent et en cas de non-réponse du standard : 07 63 85 83 11 <br>- Mail : defibrilatteur@cardiacsafe.fr <br><br> <b>ARTICLE 5 : DISPOSITIONS FINANCIERES.</b> <br><br> En contrepartie de l’opération de maintenance préventive annuelle, le client s’acquittera des coûts suivants dès souscription du contrat : <br><br> - Coût d’une intervention par appareil et par an <span style=\"background-color:#f1c40f\">HT : 200 Euros</span> <br><br> TVA (20 %) : <span style=\"background-color:#f1c40f\">40 Euros ;</span> <br>Coût d’une intervention <span style=\"background-color:#f1c40f\">TTC : 240 Euros</span> <br>Cette somme couvre l’intégralité des frais, y compris les frais des consommables (électrodes et batteries) hors déplacement du technicien habilité <br><br> - Coût d’un déplacement par site et par intervention <span style=\"background-color:#f1c40f\">HT : 35 Euros</span> <br><br> Cette somme couvre l’intégralité des frais du déplacement du technicien habilité <br>La proposition de prix ci-dessus est valable pour les années durant laquelle courra le présent contrat. <br>Pour tenir compte de l’évolution des prix des marchandises et autres consommables utilisés, la société pourra réviser ses prix à chaque reconduction, sans que cela constitue un motif de rupture de contrat par le client. <br><br> En contrepartie de l’intervention d’un technicien en cas d’utilisation du défibrillateur sur une personne victime d’un arrêt cardiaque ou d’une mise en défaut signalé sur un appareil (Hors péremption électrodes et/ou batterie)) afin de remettre en état le défibrillateur, le client s’acquittera des coûts suivants hors frais de déplacement :<br><br><br><br><br> - Coût d’une intervention <span style=\"background-color:#f1c40f\">HT : 150.00 Euros</span><br> - TVA (20 %) : <span style=\"background-color:#f1c40f\">30.00 Euros ;</span><br> - Coût d’une intervention <span style=\"background-color:#f1c40f\">TTC : 180.00 Euros</span> <br><br> <b>ARTICLE 6 : LIMITES DU PRÉSENT CONTRAT.</b> <br><br> La prestation proposée présente un caractère de prévention qui ne peut cependant pas prémunir contre certaines pannes à caractère imprévisible : <br><br> - Dégradation<br> - Incendie<br> - Utilisation non appropriée <br><br> Ce type de panne devra faire l’objet d’une demande de dépannage au coup par coup, intervention exclue du présent contrat. <br><br> <b>ARTICLE 7 : SERVICE APRÈS-VENTE.</b> <br><br> En cas de panne prolongée, <b>CARDIAC SAFE</b> est en mesure de mettre à disposition un défibrillateur de prêt pendant la durée de réparation. <br><br> Ce prêt fait l’objet d’une prise en charge gratuite. <br><br> <b>ARTICLE 8 : CLAUSES RESOLUTOIRES.</b> <br><br> Le présent contrat peut être résilié sans préavis en cas de cessation d’activité de l’une ou l’autre des parties, ou en cas de nomination d’un administrateur judiciaire par l’une ou l’autre des parties. <br><br> <b>ARTICLE 9 : MODIFICATIONS OU AMENDEMENTS.</b> <br><br> Le présent contrat ne pourra être modifié ou amendé que par un accord écrit et signé par les deux parties. <br><br> <b>ARTICLE 10 : LOI APPLICABLE – TRIBUNAL COMPETENT.</b> <br><br> Le présent contrat sera régi par la loi française et interprété conformément à cette loi.<br> Si une contestation ou un différend ne peuvent être réglés à l’amiable, le Tribunal judiciaire du siège de <b>CARDIAC SAFE</b> sera seul compétent pour régler le litige. <br><br> <b>ARTICLE 11 : Défibrillateurs faisant l’objet du présent contrat de maintenance préventive ET CURATIVE.</b> </p>";
											input.Valeur_du_contrat = "200";
										}
						)
					}
					actions 
					{
						custom deluge script
						(
											if(contract_choice == "Contrat simple")
										{
											input.Rich_Text = "<p> Il a été convenu ce qui suit : <br><br> ARTICLE 1 : PRESTATIONS PROPOSÉES : <br><br> a. <b>CARDIAC SAFE</b> assurera la maintenance préventive et curative annuelle, dans le cadre de la matériovigilance concernant les matériels de Type classe 2B, et classe 3 conformément aux recommandations du constructeur ainsi que de l’Agence Nationale de Sécurité du Médicament et des produits de santé (ANSM) et procèdera au changement de consommables électrodes et batterie, à leur date de péremption.<br> b. <b>CARDIAC SAFE</b> assurera également l’intervention d’un technicien en cas d’utilisation du défibrillateur sur une personne victime d’un arrêt cardiaque ou d’une mise en défaut signalé sur l’appareil afin de remettre en état le défibrillateur (Maintenance curative).<br> c. Le coût annuel correspond au passage chaque année du technicien ainsi que le coût des consommables, électrodes et batterie, à chaque fois que cela est nécessaire lissé sur 8 années, la durée de garantie du défibrillateur. Vous maîtriser ainsi le coût d’entretien de l’appareil sans surprise.<br> d. En cas de problème sur un défibrillateur durant sa période de garantie, ce dernier sera remplacé par un appareil neuf, si l’intervention d’un technicien ne permet pas de régler la panne par des opérations de maintenance classiques. Au-delà de la garantie de 8 ans, toutes interventions se feront sur devis <br><br> <b>ARTICLE 2 : CONDITIONS DE REALISATION.</b> <br><br> <b>CARDIAC SAFE</b>, vous proposera le passage d’un technicien habilité après prise de rendez-vous, chaque année dans le mois anniversaire de l’installation du défibrillateur <b>ou en rapport</b> avec la date de changement des consommables afin de pouvoir effectuer ces opérations en un seul passage. <br><br> À l’issue de l’opération de maintenance préventive et/ou curative effectuée conformément aux prescriptions définies dans le présent contrat, le registre de maintenance des défibrillateurs <b>Conforme au décret n° 2007-705 du 4 mai 2007</b> sera renseigné, cela faisant office de rapport d’intervention. <br><br> <b>CARDIAC SAFE</b> assurera la mise à jour de la base <b>GEO DAE conformément à l'arrêté du 29 octobre 2019</b> <br><br> Le remplacement des consommables sera effectué par le technicien le jour de son passage si cela est nécessaire, électrodes et batterie sans coût supplémentaire. <br><br> Les opérations de la maintenance préventive garantissent le bon fonctionnement du défibrillateur conformément aux recommandations du constructeur ainsi que de l’Agence Nationale de Sécurité du Médicament et des produits de santé (ANSM). <br><br> Elles consistent à : <br><br> 1. Contrôler le bon état général du défibrillateur. <br> 2. Vérifier les dates de péremption (électrodes et batterie).<br> 3. Contrôler la puissance restante de la batterie jusqu’à la prochaine visite.<br> 4. Vérifier les invites vocales conformément aux données du constructeur et des recommandations internationales.<br> 5. Faire choquer le défibrillateur, en cas de besoin, au moyen simulateur et d’un joule-mètre afin de vérifier si le condensateur délivre un choc conformément aux données du constructeur.<br> 6. Importer et analyser les données internes du défibrillateur grâce à un logiciel afin d’établir un rapport détaillé remis au commanditaire.<br> 7. Nettoyer le défibrillateur et son support le cas échéant avec produit neutre et chiffon doux.<br> 8. Apporter les conseils éclairés sur l’emplacement du ou des défibrillateurs.<br> 9. Mettre à jour le défibrillateur en cas d’évolution des recommandations internationales.<br> 10. Enregistrer le défibrillateur dans la base de données nationale <b>GEO DAE conformément à l'arrêté du 29 octobre 2019.</b><br> <br><br> <b>ARTICLE 3 : DUREE DU CONTRAT.</b> <br><br> Le présent contrat est conclu pour une durée de <b>1 an</b> et entrera en vigueur à partir de la date de la signature du contrat de maintenance du défibrillateur. Il donnera lieu à une facturation annuelle et sera renouvelable par tacite reconduction (pour la durée indiquée ci-dessus), sauf si l’une des parties adressée par écrit, au moins un mois avant l’expiration de la période des 48 mois, une notification de non-renouvellement à l’autre partie. <br><br> <b>ARTICLE 4 : CONTACTS.</b> <br><br> Commandes accessoires, demandes d’intervention :	07 63 85 83 11<br> Contact urgent et en cas de non-réponse du standard : 07 63 85 83 11<br> Mail : 	defibrilatteur@cardiacsafe.fr <br><br> <b>ARTICLE 5 : DISPOSITIONS FINANCIERES.</b> <br><br> En contrepartie de l’opération de maintenance préventive annuelle, le client s’acquittera des coûts suivants dès souscription du contrat : <br><br> - Coût d’une intervention par appareil et par an <span style=\"background-color:#f1c40f\">HT : 120 Euros</span> <br><br> TVA (20 %) : <span style=\"background-color:#f1c40f\">24 Euros ;</span><br> Coût d’une intervention <span style=\"background-color:#f1c40f\">TTC : 144 Euros</span><br> Cette somme couvre l’intégralité des frais, y compris les frais des consommables (électrodes et batteries) hors déplacement du technicien habilité <br><br> - Coût d’un déplacement par site et par intervention <span style=\"background-color:#f1c40f\">HT : 35 Euros</span> <br><br> Cette somme couvre l’intégralité des frais du déplacement du technicien habilité <br> La proposition de prix ci-dessus est valable pour les années durant laquelle courra le présent contrat. <br> Pour tenir compte de l’évolution des prix des marchandises et autres consommables utilisés, la société pourra réviser ses prix à chaque reconduction, sans que cela constitue un motif de rupture de contrat par le client. <br><br><br><br><br> <br><br>En contrepartie de l’intervention d’un technicien en cas d’utilisation du défibrillateur sur une personne victime d’un arrêt cardiaque ou d’une mise en défaut signalé sur un appareil (Hors péremption électrodes et/ou batterie)) afin de remettre en état le défibrillateur, le client s’acquittera des coûts suivants hors frais de déplacement : <br><br> Coût d’une intervention <span style=\"background-color:#f1c40f\">HT : 150.00 Euros</span><br> TVA (20 %) : <span style=\"background-color:#f1c40f\">30.00 Euros ;</span><br> Coût d’une intervention <span style=\"background-color:#f1c40f\">TTC : 180.00 Euros</span> <br><br> <b>ARTICLE 6 : LIMITES DU PRÉSENT CONTRAT.</b> <br><br> La prestation proposée présente un caractère de prévention qui ne peut cependant pas prémunir contre certaines pannes à caractère imprévisible : <br><br> - Dégradation<br> - Incendie<br> - Utilisation non appropriée <br><br> Ce type de panne devra faire l’objet d’une demande de dépannage au coup par coup, intervention exclue du présent contrat. <br><br> <b>ARTICLE 7 : SERVICE APRÈS-VENTE.</b> <br><br> En cas de panne prolongée, <b>CARDIAC SAFE</b> est en mesure de mettre à disposition un défibrillateur de prêt pendant la durée de réparation. <br><br> Ce prêt fait l’objet d’une prise en charge gratuite. <br><br> <b>ARTICLE 8 : CLAUSES RESOLUTOIRES.</b> <br><br> Le présent contrat peut être résilié sans préavis en cas de cessation d’activité de l’une ou l’autre des parties, ou en cas de nomination d’un administrateur judiciaire par l’une ou l’autre des parties. <br><br> <b>ARTICLE 9 : MODIFICATIONS OU AMENDEMENTS.</b> <br><br> Le présent contrat ne pourra être modifié ou amendé que par un accord écrit et signé par les deux parties. <br><br> <b>ARTICLE 10 : LOI APPLICABLE – TRIBUNAL COMPETENT.</b> <br><br> Le présent contrat sera régi par la loi française et interprété conformément à cette loi.<br> Si une contestation ou un différend ne peuvent être réglés à l’amiable, le Tribunal judiciaire du siège de <b>CARDIAC SAFE</b> sera seul compétent pour régler le litige. <br><br> <b>ARTICLE 11 : Défibrillateurs faisant l’objet du présent contrat de maintenance préventive ET CURATIVE.</b> </p>";
											input.Valeur_du_contrat = "150";
