44307877943","type":"fields","element":{"valueStyle":"width: 50%","valueTextStyle":"","fieldLayoutType":"2","labelText":"Date de péremption de l'électrode 3","wrapperStyle":"","labelStyle":"width: 50%","Label_Name":"Date_de_p_remption_de_l_lectrode_3","labelTextStyle":""}}]}]}},{"type":"columns","element":{"split":"100","id":"u_elem_3252696899999857","elemStyle":"","collayouts":[{"colElements":[{"type":"spacer","element":{"id":"u_elem_4213789199999809","height":"35"}},{"type":"text","element":{"id":"u_elem_3252696899999857","fields":[],"content":"<div style=\"outline: none\"> \n   <p><font\n      size=\"3\"><span><\/span><\/font><\/p> \n   <p><font size=\"3\"><font\n      size=\"3\">Nous vous remercions de votre confiance,<\/font><\/font><\/p> \n   <p><font\n        size=\"3\"><font size=\"3\"><br /><\/font><\/font><\/p> \n   <p><font\n        size=\"3\"><font size=\"3\">L&#39;équipe SP Enseignement,<\/font><\/font><\/p> \n   <p><\/p> \n  <\/div>"}},{"type":"spacer","element":{"id":"u_elem_4217632699999809","height":"35"}}]}]}},{"type":"columns","element":{"split":"100","id":"u_elem_3252697399999857","elemStyle":"","collayouts":[{"colElements":[{"type":"image","element":{"imageId":"img_35393672999999523","size":"S","src":"https://creator.zoho.eu/appbuilder/safe.roeschronan.ccspublisher/spilot/downLoadImage?imgFileId=2940678000000002091&imgFileName=1662114607230_saoecomtemp.png","captionMargin":"0px auto","alt":"","caption":"","id":"u_elem_32526972999999523","align":"center","elemStyle":"border: 0px solid rgb(169, 169, 169); margin-top: 5px; padding-left: 8px; width: 150px","formCompId":""}}]}]}}],"id":1}],"resize":"A4","header":{"imageId":"","elements":[{"type":"columns","element":{"split":"100","id":"u_elem_32526832999999523","elemStyle":"","collayouts":[{"colElements":[{"type":"columns","element":{"split":"100","id":"u_elem_32526911999998093","elemStyle":"","collayouts":[{"colElements":[{"type":"image","element":{"imageId":"img_32665250999999046","size":"M","src":