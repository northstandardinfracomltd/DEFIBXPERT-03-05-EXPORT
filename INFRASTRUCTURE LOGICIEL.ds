			filters
			(
				Quel_op_rateur_doit_faire_la_visite
			)
			options
			(
				display type = month
				week start day = sunday
				display field = Localisation_de_la_visite
				start date = Quand_l_op_rateur_doit_passer
				default date 
				(
	    			day   = Today
	    			month = Currentmonth
	    			year  = Currentyear
				)
			)
			conditional formatting
			(
				"egzzeG"
				{
				format = "color:#ffffff;background-color:#2d3b90;"
				}
			)
			customlayouts
			(
				template
	 			(
	 	  			displayname="Custom Layout 1"
	 	  			content="<panel  \n >\n	<pr \n			width='fill'\n		height='fill'\n>\n	<pc \n		padding = '0px'\n	bgColor = 'transparent'\n\n		width = '100%'\n		hAlign = 'center'\n		vAlign = 'middle'\n>\n	<pr \n			width='fill'\n		height='fill'\n>\n	<pc \n		padding = '20px'\n	bgColor = '#4E96F4'\n\n		width = '40%'\n		hAlign = 'center'\n		vAlign = 'middle'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n		padding = '5px'\n\n		hAlign = 'center'\n		vAlign = 'middle'\n>\n	<pr \n	>\n	<pc \n	\n>\n	<image  \n	\n	color = '#FFFFFF'\n	type = 'icon'\n	value = 'ui-1-calendar-grid-58'\n	size = '22px'\n	iconType = 'solid'\n/>\n</pc>\n</pr><pr \n	>\n	<pc \n	\n>\n	<text \n\n	marginLeft = '0px'\n	marginRight = '0px' \n	marginBottom = '0px'\n	marginTop = '0px'\n	color = '#FFFFFF'\n	size = '16px'\n	uppercase = 'false' \n	underline = 'false' \n	bold = 'true' \n	italic = 'false' \n	type = 'field'\n\n\n\n	  \n      	lineHeight = '24'\n      	  numOfLines = '1'\n	  value = 'Quand_l_op_rateur_doit_passer'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc><pc \n		padding = '20px'\n	bgColor = 'transparent'\n\n		width = '60%'\n		hAlign = 'left'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n		padding = '0px'\n\n		hAlign = 'left'\n		vAlign = 'middle'\n>\n	<pr \n	>\n	<pc \n	\n>\n	<text \n\n	color = '#4E96F4'\n	size = '15px'\n	uppercase = 'false' \n	underline = 'false' \n	bold = 'false' \n	italic = 'false' \n	type = 'field'\n\n\n\n	  \n      	lineHeight = '22'\n      	  numOfLines = '1'\n	  value = 'DAE_Num_ro_de_s_rie'\n>\n</text>\n\n</pc>\n</pr><pr \n	>\n	<pc \n	\n>\n	<text \n\n	marginLeft = '0px'\n	marginRight = '0px' \n	marginBottom = '8px'\n	marginTop = '15px'\n	color = '#132437'\n	size = '20px'\n	uppercase = 'false' \n	underline = 'false' \n	bold = 'true' \n	italic = 'false' \n	type = 'field'\n\n\n\n	  \n      	lineHeight = '29'\n      	  numOfLines = '1'\n	  value = 'Auto_Number'\n>\n</text>\n\n</pc>\n</pr><pr \n	>\n	<pc \n	\n>\n	<text \n\n	marginLeft = '0px'\n	marginRight = '0px' \n	marginBottom = '0px'\n	marginTop = '0px'\n	color = '#2D3C4D'\n	size = '15px'\n	uppercase = 'false' \n	underline = 'false' \n	bold = 'false' \n	italic = 'false' \n	type = 'field'\n\n\n\n	  \n      	lineHeight = '22'\n      	  numOfLines = '3'\n	  value = 'Quel_op_rateur_doit_faire_la_visite'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>"
	    		)
			)
		}
		default list Inventaire_Report
		{
			displayName = "Tous les Stocks"
			print template = R_c_piss_du_produit
			show all rows from Inventaire    
			(
				titreproduit as "Dénomination"
				(
					width = 157px
				)
				Quantit_en_stock as "Stock"
				Description_du_produit as "Description"
				Statut as "Situation"
				Tarif_TTC_unitaire as "Montant HT Valeur Achat (Unitaire)"
				(
					width = 276px
				)
				R_f_rence_du_bon_de_livraison as "Référence BL"
				(
					width = 141px
				)
				Date_de_livraison as "Livré Le"
				(
					width = 102px
				)
				product_type as "Type"
				DAE_Num_ro_de_s_rie as "N° de Série"
				(
					width = 122px
				)
				in_stock as "Entre Le"
				(
					width = 99px
				)
				out_stock as "Sortant Le"
				(
					width = 104px
				)
				Date_p_remption as "Date Pér."
				(
					width = 107px
				)
				D_nomination_normalis_e as "Sélection Dénomination"
				custom action "Retirer 1"
				(
	  			workflow = remove_1_and_create_1_spe
				show action in edit record menu = true
				column header = "Retirer 1"
				condition = (product_type != "Défibrillateur" && Quantit_en_stock1 >= 1)
				confirmation before execution
				(
					message for individual record = "De quoi s'agit-il ? DéfibXpert va retirer 1 unité pour ce stock"
					confirm button text = "Retirer 1"		
					cancel button text = "Retour"
				)
				)
				O_est_stock_le_produit as "Annotations"
				Fournisseur
				(
					width = 114px
				)
				Valeur_HT_fiche as "Valeur HT (statistiques)"
				Quantit_en_stock1 as "Qté Stock"
				(
					width = 110px
				)
				custom action "Archiver"
				(
	  			workflow = archivermaintenant
				show action in edit record menu = true
				column header = "Archiver"
				condition = (product_type != "Défibrillateur")
				confirmation before execution
				(
					message for individual record = "De quoi s'agit-il ? DéfibXpert va archiver ce stock"
					confirm button text = "Archiver"		
					cancel button text = "Retour"
				)
				)
				N_de_lot_de_la_batterie as "Lot Batterie"
				Date_de_p_remption_de_la_batterie as "Péremption Batterie"
				N_de_lot_de_l_lectrode as "Lot Électrode"
				dateperelectrode as "Péremption Électrode"
				R_f_renceproduit as "Référenceproduit"
				Client
				Localisation_du_d_fibrillateur  as "Adresse"
	 			(
	      			displayformat = [address_line_1+""+address_line_2+""+district_city+""+state_province+""+postal_Code+""+country]
	      			enable = Link_to_Map,Show_As_Text
	 			)
				custom action "Activer Défibrillateur"
				(
	  			workflow = move2dae
				show action in edit record menu = true
				column header = "Activer Défibrillateur"
				condition = (product_type == "Défibrillateur" && Quantit_en_stock1 == 1)
				confirmation before execution
				(
					message for individual record = "De quoi s'agit-il ? Le défibrillateur va être déployé dans DéfibXpert + La ligne va être placée avec Stocks Archivés"
					confirm button text = "Activer"		
					cancel button text = "Retour"
				)
				)
				Heddde as "Valeur Stocks Total HT"
				(
					width = 221px
				)
				Mail_client as "Mail client"
				Mail_principal as "Mail principal"
				T_l_phone as "Téléphone"
			)
			group by
			(
				product_type ascending
			)
			sort by
			(
				Quantit_en_stock1 descending
			)
			conditional formatting
			(
				"New Formatting"
				{
				fields = [Description_du_produit]
				format = "color:#2f78d0;background-color:#e8eefd;"
				}
				"dzedzed"
				{
				condition = (Statut == "Épuisé")
				fields = [Statut]
				format = "color:#cc1111;background-color:#fce7e7;"
				}
				"dazfrzer"
				{
				condition = (Statut == "Réassort")
				fields = [Statut]
				format = "color:#cc9711;background-color:#fcf2e7;"
				}
				"zeeazfzaf"
				{
				condition = (Statut == "En stock")
				fields = [Statut]
				format = "color:#4ea64c;background-color:#eaf5ea;"
				}
				"New Formatting"
				{
				fields = [Quantit_en_stock]
				format = "color:#ffffff;background-color:#1378bd;"
				}
				"New Formatting ALLLL"
				{
				fields = [titreproduit, Tarif_TTC_unitaire, R_f_rence_du_bon_de_livraison, Date_de_livraison, product_type, DAE_Num_ro_de_s_rie, in_stock, out_stock, Date_p_remption, Fournisseur, Quantit_en_stock1, Heddde]
				format = "color:#2d3b90;background-color:#f7f8ff;"
				}
			)
		}
