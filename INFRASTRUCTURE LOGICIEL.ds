		}
		form Planificateur
		{
			title 
    		{
				displayname = "Visite Spontanée"
    			on add = "Planifier MES ou MAIN DéfibXpert"
   	 			on edit = "MAJ MAIN"
			}
			success message = "Emails Envoyés + Visite Enregistrée dans DéfibXpert"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			plain
			(
    			type = plaintext
				value = "<div><span class=\"size\" style=\"font-size: 13.3333px\">&nbsp;<br /></span></div><div><span class=\"font\" style=\"font-family: Lato, sans-serif\"><span class=\"colour\" style=\"color: rgb(0, 0, 0)\"><span class=\"size\" style=\"font-size: 13.3333px\">Bon à savoir&nbsp;—&nbsp;Lors de l'enregistrement d'une intervention sur DéfibXpert, un email est envoyé au technicien incluant un lien personnalisé pour effectuer l'intervention. Un autre email est envoyé au responsable de site du client pour l'informer de l'intervention. Vous pouvez renvoyer l'email au technicien en cas de besoin depuis l'onglet incluant la liste des visites.</span></span></span><span class=\"colour\" style=\"color: rgb(0, 0, 0)\"><span class=\"size\" style=\"font-size: 13.3333px\"><br /></span></span></div><div><span class=\"font\" style=\"font-family: Lato, sans-serif\"><span class=\"size\" style=\"font-size: 13.3333px\">&nbsp;</span></span><br /></div>"
	 			row = 1
	 			column = 1   
				width = medium
			)
			authtoken
			(
    			type = text
				displayname = "Token d'autorisation"
				private = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have DAE_Num_ro_de_s_rie
			(
				type = picklist	
				displayname = "Défibrillateur"
				values  = DAE.ID
    			displayformat = [MiniCode1 + " " + P_le + " " + Information_Adresse]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = 500px
			)
			doublecheckauth
			(
    			type = text
				displayname = "Double Confirmation"
	 			row = 1
	 			column = 1   
				width = 160px
			)
			Emailrs
			(
    			type = email
				displayname = "Mail client"
				maxchar = 80
    			description
    			[
    				type = none
    			 	message = "L'email automatiquement renseigné au choix du N° Série provient de l'email dans la fiche de l'appareil, il ne provient pas de la fiche Client qui est l'email de facturation et non celui du responsable de l'établissement par exemple."
    			]
	 			row = 1
	 			column = 1   
				width = 500px
				personal data = true
			)
			Email_du_site
			(
    			type = email
				displayname = "Mail site"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = 500px
				personal data = true
			)
			Autre_Email_de_contact
			(
    			type = email
				displayname = "Mail rapport"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Type_de_visite
			(
				type = picklist
				displayname = "Type"
				maxchar = 100
				values = {"Mise en Service","Maintenance Préventive Annuelle","Maintenance Curative","Mise en Service - Formation A.M.D"}
	 			row = 1
	 			column = 1   
				width = 500px
			)
			Situation_de_la_visite
			(
				type = picklist
				displayname = "Situation de la visite"
				maxchar = 100
				values = {"Enregistré","À mettre en place"}
				initial value = "Enregistré"
				private = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Quel_op_rateur_doit_faire_la_visite
			(
				type = list	
				displayname = "Technicien"
				values  = Intervenants.ID
    			displayformat = [Nomooo92]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 1   
				width = 500px
			)
			must have Emailrequerant
			(
    			type = email
				displayname = "Email (du technicien)"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = 500px
				personal data = true
			)
			must have Quand_l_op_rateur_doit_passer
			(
    			type = date
				displayname = "Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = 340px
			)
			Information_Adresse
			(
    			type = text
				displayname = "Information Adresse"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Localisation_de_la_visite
			(
    			type = address
				displayname = "Adresse"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Ligne 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Ligne 2"
	     			 visibility = false
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "Ville"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "Région"
	     			 visibility = false
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Code Postal"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Pays"
	     			 visibility = false
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = large
				personal data = true
			)
			Auto_Number
			(
    			type = autonumber
				displayname = "Auto Number"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			reportcontrat_cacher
			(
    			type = text
				displayname = "reportcontratàcacher"
				private = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Client_to_hide
			(
				type = picklist	
				displayname = "client à cacher!!!"
				values  = Clients.ID
    			displayformat = [Client]
				sortorder = ascending
				private = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Annotations_Standards
			(
				type = picklist
				displayname = "Annotations Standards"
				maxchar = 100
				values = {"Électrode à remplacer","Batterie à remplacer","Électrode et Batterie à remplacer","Formation A.M.D","Néant"}
	 			row = 1
	 			column = 1   
				width = 340px
			)
			must have Pr_cisions_l_op_rateur_territorial
			(
    			type = textarea
				displayname = "Annotations"
				height = 100px
    			description
    			[
    				type = help_text
    			 	message = "Entrez \"Néant\" ou un tiret au minimum"
    			]
	 			row = 1
	 			column = 1   
				width = 340px
			)
			Donn_es_avanc_es
			(
				type = section
				displayname = ""
	 			row = 2
	 			column = 0   
				width = medium
			)
			Situation_contractuelle_avec_le_client
			(
    			type = text
				displayname = "Situation contractuelle active pour ce défibrillateur"
    			description
    			[
    				type = tooltip
    			 	message = "Lorsque vous sélectionnez un défibrillateur à l'aide du numéro de série, SPILOT vous indique ici si un contrat est actif pour celui-ci. Ainsi, si ce présent renseignement est vide, aucun contrat n'est actif pour ce défibrillateur."
    			]
				private = true
	 			row = 2
	 			column = 1   
				width = medium
			)
			Requiert_une_facturation_si_aucun_contrat
			(
				type = checkboxes	
				displayname = "Requiert une facturation? (Si aucun contrat)"
				initial value = {"Oui"}
				values = {"Oui"}
    			description
    			[
    				type = tooltip
    			 	message = "À la création de la visite, vous devez cocher cette case pour informer le service comptable, si vous ne la cochez pas, le service comptable ne récupéra pas l'information de facturation."
    			]
				private = true
	 			row = 2
	 			column = 1   
				width = medium
			)
			Si_hors_contrat_quel_est_le_statut
			(
				type = picklist
				displayname = "Statut de la facturation? (Si aucun contrat)"
				maxchar = 100
				values = {"À facturer","Facturé","Pas de facturation requise","En attente","Payée / Terminée","Inconnu"}
				private = true
	 			row = 2
	 			column = 1   
				width = medium
			)
			Num_ro_de_devis_ou_facture_pour_cette_visite
			(
    			type = text
				displayname = "Disposez-vous d'un numéro de devis ou facture ?"
    			description
    			[
    				type = tooltip
    			 	message = "Lorsque aucun contrat n'est actif, vous devez émettre un devis et le recevoir signé en retour du client avant d'activer une visite ; par conséquent renseignez ici le numéro du devis signé. Vous pouvez aussi renseigner le numéro de facture autrement."
    			]
				private = true
	 			row = 2
	 			column = 1   
				width = medium
			)
			Montant_HT_facturer_pour_la_visite
			(
				type = decimal
				displayname = "Si oui, reportez le montant HT à facturer (Si pièce comptable)"
				private = true
	 			row = 2
	 			column = 1   
				width = medium
			)
			Veuillez_t_l_charger_la_pi_ce_comptable
			(
    			type = upload file
				displayname = "Vous pouvez télécharger la pièce comptable"
				browse = local_drive, google_docs, zoho_docs
    			description
    			[
    				type = tooltip
    			 	message = "Si vous avez un devis signé, une facture ou autre pièce comptable (format PDF), nous vous recommandons de la télécharger."
    			]
				private = true
	 			row = 2
	 			column = 1   
				width = medium
			)
			Commentaires_libres
			(
    			type = textarea
				displayname = "Commentaire adressé au service comptabilité"
				height = 50px
				private = true
	 			row = 2
	 			column = 1   
				width = medium
			)
			Forcer_l_intervention
			(
				type = checkboxes	
				displayname = "Forcer la visite ? (Optionnel)"
				values = {"Oui je m'engage"}
    			description
    			[
    				type = tooltip
    			 	message = "Si le client ne dispose pas de contrat actif pour ce défibrillateur et que vous ne disposez d'aucune pièce comptable, vous pouvez engager votre responsabilité pour envoyer un technicien sans facturation."
    			]
				private = true
	 			row = 2
	 			column = 1   
				width = medium
			)
			Qui_cr_la_visite
			(
				type = picklist	
				displayname = "Qui engage la présente visite ?"
				values  = PinBadges.ID
    			displayformat = [Nom_et_pr_nompin]
				sortorder = ascending
				private = true
	 			row = 2
	 			column = 2   
				width = medium
			)
			Pinconfirm
			(
    			type = text
				private = true
	 			row = 2
	 			column = 2   
				width = medium
			)
			Pinconfirmrfid
			(
    			type = text
				displayname = "Entrez votre PIN personnel à 4 chiffres"
				maxchar = 4
				private = true
	 			row = 2
	 			column = 2   
				width = 43px
			)
	
			actions
			{
				on add
				{
					Planifier
					(
   						type = submit
   						displayname = "Planifier"
					)
				}
				on edit
				{
					Mettre___jour
					(
   						type = submit
   						displayname = "Mettre à jour"
					)
					Retour
					(
   						type = cancel
   						displayname = "Retour"
					)
				}
			}
